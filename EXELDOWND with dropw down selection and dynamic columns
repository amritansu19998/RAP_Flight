*----------------------------------------------------------------------*
* Recalculate formula fields (same logic as the Excel formulas)
*----------------------------------------------------------------------*
FORM months_between USING iv_from TYPE d iv_to TYPE d CHANGING cv TYPE p.
  DATA lv_p TYPE p LENGTH 8 DECIMALS 0.
  CLEAR cv.
  IF iv_from IS INITIAL OR iv_to IS INITIAL.
    RETURN.
  ENDIF.
  lv_p = ( iv_to - iv_from ) / gc_divisor.        " ROUND(..,0)
  cv = lv_p.
ENDFORM.

* DATEDIF(from, to, "m") - complete months
FORM datedif_m USING iv_from TYPE d iv_to TYPE d CHANGING cv TYPE i.
  DATA: lv_y1 TYPE i, lv_m1 TYPE i, lv_d1 TYPE i,
        lv_y2 TYPE i, lv_m2 TYPE i, lv_d2 TYPE i.
  CLEAR cv.
  IF iv_from IS INITIAL OR iv_to IS INITIAL OR iv_to < iv_from.
    RETURN.
  ENDIF.
  lv_y1 = iv_from(4). lv_m1 = iv_from+4(2). lv_d1 = iv_from+6(2).
  lv_y2 = iv_to(4).   lv_m2 = iv_to+4(2).   lv_d2 = iv_to+6(2).
  cv = ( lv_y2 - lv_y1 ) * 12 + lv_m2 - lv_m1.
  IF lv_d2 < lv_d1.
    cv = cv - 1.
  ENDIF.
ENDFORM.

FORM recalc CHANGING cs TYPE ty_line.
  DATA: lv_m   TYPE i,
        lv_tot TYPE zps_t_fr_itm-plncst.
  PERFORM months_between USING cs-plfrm cs-plto CHANGING cs-plmm.
  PERFORM months_between USING cs-rpfrm cs-rpto CHANGING cs-rpmm.
  PERFORM datedif_m      USING cs-plfrm cs-plto CHANGING lv_m.
  cs-utlpl  = lv_m * cs-qty.
  lv_tot    = cs-pl_ihc + cs-pl_opr + cs-pl_fuel.
  cs-plncst = lv_tot * cs-plmm * cs-qty.
  cs-actcst = cs-it_ihc + cs-it_opr + cs-it_fuel.
  cs-balcst = cs-plncst - cs-actcst.
  cs-waers  = gv_waers.
ENDFORM.


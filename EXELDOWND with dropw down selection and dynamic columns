* --- Equipment Class: KLAH class type 002, description from SWOR -----
  CLEAR: gt_class, gt_clseq, gt_equniq, gt_eqcls.
  SELECT clint class FROM klah INTO TABLE lt_klah
    WHERE klart = gc_klart.
  IF lt_klah IS NOT INITIAL.
    SELECT clint kschl FROM swor INTO TABLE lt_swor
      FOR ALL ENTRIES IN lt_klah
      WHERE clint = lt_klah-clint
        AND spras = sy-langu
        AND klpos = '01'.
  ENDIF.
  LOOP AT lt_klah INTO ls_klah.
    CLEAR: ls_cl, ls_swor.
    ls_cl-clint = ls_klah-clint.
    ls_cl-class = ls_klah-class.
    READ TABLE lt_swor INTO ls_swor WITH TABLE KEY clint = ls_klah-clint.
    ls_cl-text = ls_swor-kschl.
    IF ls_cl-text IS INITIAL.
      ls_cl-text = ls_cl-class.
    ENDIF.
    ls_cl-upper = ls_cl-text.
    TRANSLATE ls_cl-upper TO UPPER CASE.
    APPEND ls_cl TO gt_class.
  ENDLOOP.

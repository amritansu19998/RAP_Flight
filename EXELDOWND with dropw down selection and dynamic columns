*----------------------------------------------------------------------*
* Column definitions - order, captions, class, format, width, formula
* Formula tokens {Column name} become Fleet[[#This Row],[Column name]]
*----------------------------------------------------------------------*
FORM init_cols.
  DATA: lv_f1 TYPE string,
        lv_f2 TYPE string,
        lv_f3 TYPE string,
        lv_f4 TYPE string.
  CLEAR gt_col.
* Own/Hired / Asset code / Sub-asset / Asset description: lookup of the
* equipment in LISTS!H:L (filled from V_EQUI / EQKT / ZPS_T_FR_EQTYP)
  CONCATENATE 'IF({Equipment code}="","",IFERROR(T(VLOOKUP({Equipment code},LISTS!$H:$L,2,FALSE)),""))' ''
    INTO lv_f1.
  CONCATENATE 'IF({Equipment code}="","",IFERROR(T(VLOOKUP({Equipment code},LISTS!$H:$L,3,FALSE)),""))' ''
    INTO lv_f2.
  CONCATENATE 'IF({Equipment code}="","",IFERROR(T(VLOOKUP({Equipment code},LISTS!$H:$L,4,FALSE)),""))' ''
    INTO lv_f3.
  CONCATENATE 'IF({Equipment code}="","",IFERROR(T(VLOOKUP({Equipment code},LISTS!$H:$L,5,FALSE)),""))' ''
    INTO lv_f4.

  PERFORM add_col USING gc_c_sno   'S.No'                          gc_cls_form  gc_fmt_gen  '6'
                        'ROW()-ROW(Fleet[[#Headers],[S.No]])' 'L'.
  PERFORM add_col USING gc_c_eqart 'Equipment Group'               gc_cls_entry gc_fmt_text '22' '' ''.
  PERFORM add_col USING gc_c_class 'Equipment Class'               gc_cls_entry gc_fmt_text '28' '' ''.
  PERFORM add_col USING gc_c_equnr 'Equipment code'                gc_cls_entry gc_fmt_text '14' '' ''.
  PERFORM add_col USING gc_c_own   'Own/Hired'                     gc_cls_slook gc_fmt_text '11' lv_f4 ''.

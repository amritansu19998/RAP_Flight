  PERFORM class_unique.
  SORT gt_class BY text.

* --- Equipment Group: object types (T370K_T), description shown ------
  CLEAR gt_eqart.
  SELECT eqart eartx FROM t370k_t INTO TABLE lt_t370k
    WHERE spras = sy-langu.
  SORT lt_t370k BY eartx eqart.
  LOOP AT lt_t370k INTO ls_t370k.
    CLEAR ls_ea.
    ls_ea-eqart = ls_t370k-eqart.
    ls_ea-eartx = ls_t370k-eartx.
    IF ls_ea-eartx IS INITIAL.
      ls_ea-eartx = ls_ea-eqart.
    ENDIF.
    ls_ea-upper = ls_ea-eartx.
    TRANSLATE ls_ea-upper TO UPPER CASE.
    READ TABLE gt_eqart TRANSPORTING NO FIELDS WITH KEY upper = ls_ea-upper.
    IF sy-subrc = 0.                     " same text twice -> add code
      CONCATENATE ls_ea-eartx ' (' ls_ea-eqart ')' INTO ls_ea-eartx.
      ls_ea-upper = ls_ea-eartx.
      TRANSLATE ls_ea-upper TO UPPER CASE.
    ENDIF.
    APPEND ls_ea TO gt_eqart.
  ENDLOOP.

* --- equipment category (EQTYP) -> Own / Lease / Hired --------------
  CLEAR gt_eqtyp.
  SELECT eqtyp ownhr FROM zps_t_fr_eqtyp INTO TABLE lt_et.
  INSERT LINES OF lt_et INTO TABLE gt_eqtyp.

* --- Equipment of the project plant (current time segment) ----------
* CONFIRM: ZZITO_PO_NUM is available in V_EQUI (customer append / view)
  IF gs_proj-werks IS INITIAL.
    RETURN.
  ENDIF.
  SELECT equnr eqart eqtyp anlnr anlun bukrs daufn datab datbi zzito_po_num
    FROM v_equi INTO TABLE lt_veq
    WHERE swerk = gs_proj-werks
      AND datbi = gc_open_date.
  SORT lt_veq BY equnr.
  DELETE ADJACENT DUPLICATES FROM lt_veq COMPARING equnr.
  IF lt_veq IS INITIAL.
    RETURN.
  ENDIF.
  SELECT equnr eqktx FROM eqkt INTO TABLE lt_eqkt
    FOR ALL ENTRIES IN lt_veq
    WHERE equnr = lt_veq-equnr
      AND spras = sy-langu.

  LOOP AT lt_veq INTO ls_veq.
*   cache for READ_EQUI
    CLEAR: ls_eq, ls_eqkt.
    READ TABLE lt_eqkt INTO ls_eqkt WITH TABLE KEY equnr = ls_veq-equnr.
    ls_eq-equnr = ls_veq-equnr.
    ls_eq-found = abap_true.
    ls_eq-swerk = gs_proj-werks.
    ls_eq-anlnr = ls_veq-anlnr.
    ls_eq-anlun = ls_veq-anlun.
    ls_eq-bukrs = ls_veq-bukrs.
    ls_eq-daufn = ls_veq-daufn.
    ls_eq-datab = ls_veq-datab.
    ls_eq-datbi = ls_veq-datbi.
    ls_eq-eqktx = ls_eqkt-eqktx.
    ls_eq-ebeln = ls_veq-ebeln.
    ls_eq-eqart = ls_veq-eqart.
    ls_eq-eqtyp = ls_veq-eqtyp.
    PERFORM equi_ownhr CHANGING ls_eq.
    INSERT ls_eq INTO TABLE gt_equi.
*   lookup list: equipment -> asset, sub-asset, description
    CLEAR ls_uq.
    PERFORM alpha_out USING ls_veq-equnr CHANGING ls_uq-equnr.
    PERFORM asset_key USING ls_veq-anlnr '0000' CHANGING ls_uq-anln.
    PERFORM sub_text USING ls_veq-anlnr ls_veq-anlun CHANGING ls_uq-anlun.
    ls_uq-eqktx = ls_eqkt-eqktx.
    PERFORM ownhr_text USING ls_eq-ownhr CHANGING ls_uq-own.
    APPEND ls_uq TO gt_equniq.
*   classification object key (INOB-OBJEK = equipment number)
    ls_obj-objek = ls_veq-equnr.
    APPEND ls_obj TO lt_obj.
  ENDLOOP.

* --- equipment -> class: INOB (CUOBJ) -> KSSK (CLINT) -----------------
* Spec path KLAH-CLINT -> KSSK-OBJEK -> INOB-CUOBJ -> INOB-OBJEK = EQUNR,
* read from the plant's equipment backwards (same result, smaller reads).
  SELECT cuobj objek FROM inob INTO TABLE lt_inob
    FOR ALL ENTRIES IN lt_obj
    WHERE objek = lt_obj-objek
      AND obtab = 'EQUI'
      AND klart = gc_klart.
  LOOP AT lt_inob INTO ls_inob.
    ls_kobj-objek = ls_inob-cuobj.
    APPEND ls_kobj TO lt_kobj.
  ENDLOOP.
* fallback: equipment classified directly (KSSK-OBJEK = EQUNR, no INOB)
  LOOP AT lt_obj INTO ls_obj.
    ls_kobj-objek = ls_obj-objek.
    APPEND ls_kobj TO lt_kobj.
  ENDLOOP.
  SELECT objek clint FROM kssk INTO TABLE lt_kssk
    FOR ALL ENTRIES IN lt_kobj
    WHERE objek = lt_kobj-objek
      AND mafid = 'O'
      AND klart = gc_klart
      AND lkenz = space.

  SORT lt_inob BY cuobj.
  LOOP AT lt_kssk INTO ls_kssk.
    CLEAR lv_eq.
    IF ls_kssk-objek(18) CO '0123456789'.
      lv_cu = ls_kssk-objek.
      READ TABLE lt_inob INTO ls_inob WITH KEY cuobj = lv_cu BINARY SEARCH.
      IF sy-subrc = 0.
        lv_eq = ls_inob-objek.
      ENDIF.
    ENDIF.
    IF lv_eq IS INITIAL.
      lv_eq = ls_kssk-objek.                       " direct classification
      READ TABLE gt_equi TRANSPORTING NO FIELDS WITH TABLE KEY equnr = lv_eq.
      CHECK sy-subrc = 0.
    ENDIF.
    READ TABLE gt_class INTO ls_cl WITH KEY clint = ls_kssk-clint.
    CHECK sy-subrc = 0.
    CLEAR ls_ce.
    ls_ce-clstxt = ls_cl-text.
    PERFORM alpha_out USING lv_eq CHANGING ls_ce-equnr.
    APPEND ls_ce TO gt_clseq.
    ls_ec-equnr = lv_eq.
    ls_ec-class = ls_cl-class.
    INSERT ls_ec INTO TABLE gt_eqcls.
  ENDLOOP.
* contiguous per class - required by the dependent dropdown (OFFSET)
  SORT gt_clseq BY clstxt equnr.
  DELETE ADJACENT DUPLICATES FROM gt_clseq COMPARING clstxt equnr.
ENDFORM.

* unique dropdown text per class: "Description" or "Description (CLASS)"
FORM class_unique.
  DATA: ls_cl   TYPE ty_class,
        ls_nx   TYPE ty_class,
        lv_ix   TYPE i,
        lv_nx   TYPE i,
        lv_dup  TYPE abap_bool,
        lv_prev TYPE string.
  SORT gt_class BY upper class.
  LOOP AT gt_class INTO ls_cl.
    lv_ix = sy-tabix.
    lv_nx = lv_ix + 1.
    CLEAR lv_dup.
    IF ls_cl-upper = lv_prev.
      lv_dup = abap_true.
    ELSE.
      READ TABLE gt_class INTO ls_nx INDEX lv_nx.
      IF sy-subrc = 0 AND ls_nx-upper = ls_cl-upper.
        lv_dup = abap_true.
      ENDIF.
    ENDIF.
    lv_prev = ls_cl-upper.
    IF lv_dup = abap_true AND ls_cl-text <> ls_cl-class.
      CONCATENATE ls_cl-text ' (' ls_cl-class ')' INTO ls_cl-text.
      MODIFY gt_class FROM ls_cl INDEX lv_ix TRANSPORTING text.
    ENDIF.
  ENDLOOP.
  LOOP AT gt_class INTO ls_cl.
    ls_cl-upper = ls_cl-text.
    TRANSLATE ls_cl-upper TO UPPER CASE.
    MODIFY gt_class FROM ls_cl TRANSPORTING upper.
  ENDLOOP.
ENDFORM.

* 000000200045 / 0001 -> "200045-1"; sub-number 0 -> "200045"
FORM asset_key USING iv_anln1 TYPE anln1 iv_anln2 TYPE anln2 CHANGING cv TYPE string.
  DATA lv_sub TYPE string.
  CLEAR cv.
  IF iv_anln1 IS INITIAL.
    RETURN.
  ENDIF.
  PERFORM alpha_out USING iv_anln1 CHANGING cv.
  IF iv_anln2 IS NOT INITIAL AND iv_anln2 CN '0'.
    PERFORM alpha_out USING iv_anln2 CHANGING lv_sub.
    CONCATENATE cv '-' lv_sub INTO cv.
  ENDIF.
ENDFORM.

* sub-asset number for display: 0000 -> "0", 0001 -> "1"; blank without asset
FORM sub_text USING iv_anln1 TYPE anln1 iv_anln2 TYPE anln2 CHANGING cv TYPE string.
  CLEAR cv.
  IF iv_anln1 IS INITIAL.
    RETURN.
  ENDIF.
  IF iv_anln2 IS INITIAL OR iv_anln2 CO '0'.
    cv = '0'.
  ELSE.
    PERFORM alpha_out USING iv_anln2 CHANGING cv.
  ENDIF.
ENDFORM.

*----------------------------------------------------------------------*
* Equipment master (cached). Latest time segment of V_EQUI.
* CONFIRM: ZZITO_PO_NUM (PO of hired equipment) is read from V_EQUI.
*----------------------------------------------------------------------*
FORM read_equi USING iv_equnr TYPE equnr CHANGING cs TYPE ty_equi.
  DATA ls_new TYPE ty_equi.

  READ TABLE gt_equi INTO cs WITH TABLE KEY equnr = iv_equnr.
  IF sy-subrc = 0.
    RETURN.
  ENDIF.

* not in the plant list (other plant / released) - read directly
  CLEAR ls_new.
  ls_new-equnr = iv_equnr.
  SELECT swerk eqart eqtyp anlnr anlun bukrs daufn datab datbi zzito_po_num
    FROM v_equi
    INTO (ls_new-swerk, ls_new-eqart, ls_new-eqtyp, ls_new-anlnr, ls_new-anlun,
          ls_new-bukrs, ls_new-daufn, ls_new-datab, ls_new-datbi, ls_new-ebeln)
    UP TO 1 ROWS
    WHERE equnr = iv_equnr
    ORDER BY datbi DESCENDING.
  ENDSELECT.
  IF sy-subrc = 0.
    ls_new-found = abap_true.
    SELECT SINGLE eqktx FROM eqkt INTO ls_new-eqktx
      WHERE equnr = iv_equnr AND spras = sy-langu.
    PERFORM equi_ownhr CHANGING ls_new.
  ENDIF.
  INSERT ls_new INTO TABLE gt_equi.
  cs = ls_new.
ENDFORM.

*----------------------------------------------------------------------*
* Master data + actual costs of one line for the reporting windows
*----------------------------------------------------------------------*
FORM fetch_sap USING iv_row TYPE i iv_log TYPE abap_bool CHANGING cs TYPE ty_line.
  DATA: ls_eq  TYPE ty_equi,
        lv_txt TYPE string,
        lv_ext TYPE string.

  CLEAR: cs-ac_ihc, cs-ac_opr, cs-ac_fuel, cs-it_ihc, cs-it_opr, cs-it_fuel,
         cs-ownhr, cs-utlac, cs-depdt, cs-reldt, cs-daufn, cs-ebeln, cs-anlnr, cs-anln2,
         cs-asstxt, cs-abukrs.
  IF cs-qty IS INITIAL.
    cs-qty = 1.                                " default: one equipment
  ENDIF.

  IF cs-equnr IS INITIAL.
    PERFORM recalc CHANGING cs.
    RETURN.
  ENDIF.

  PERFORM read_equi USING cs-equnr CHANGING ls_eq.
  PERFORM alpha_out USING cs-equnr CHANGING lv_ext.
  IF ls_eq-found = abap_false.
    IF iv_log = abap_true.
      CONCATENATE 'Equipment' lv_ext 'does not exist' INTO lv_txt SEPARATED BY space.
      PERFORM add_log USING iv_row 'E' lv_txt.
    ENDIF.
    PERFORM recalc CHANGING cs.
    RETURN.
  ENDIF.

  IF iv_log = abap_true.
*   equipment must be in the project plant ...
    IF ls_eq-swerk <> gs_proj-werks.
      CONCATENATE 'Equipment' lv_ext 'is in plant' ls_eq-swerk ', not in project plant' gs_proj-werks
        INTO lv_txt SEPARATED BY space.
      PERFORM add_log USING iv_row 'E' lv_txt.
    ENDIF.
*   ... and classified in the selected Equipment Class
    IF cs-class IS NOT INITIAL.
      READ TABLE gt_eqcls TRANSPORTING NO FIELDS
        WITH TABLE KEY equnr = cs-equnr class = cs-class.
      IF sy-subrc <> 0.
        CONCATENATE 'Equipment' lv_ext 'is not classified in Equipment Class' cs-clstxt
          INTO lv_txt SEPARATED BY space.
        PERFORM add_log USING iv_row 'E' lv_txt.
      ENDIF.
    ENDIF.
  ENDIF.

* master data (V_EQUI / EQKT / ZPS_T_FR_EQTYP)
  cs-ownhr  = ls_eq-ownhr.
  IF ls_eq-eqart IS NOT INITIAL.
    IF iv_log = abap_true AND cs-eqart IS NOT INITIAL AND cs-eqart <> ls_eq-eqart.
      CONCATENATE 'Equipment Group set from equipment master of' lv_ext
        INTO lv_txt SEPARATED BY space.
      PERFORM add_log USING iv_row 'I' lv_txt.
    ENDIF.
    cs-eqart = ls_eq-eqart.
    PERFORM eqart_text USING cs-eqart CHANGING cs-eqtxt.
  ENDIF.
  cs-anlnr  = ls_eq-anlnr.
  cs-anln2  = ls_eq-anlun.
  cs-abukrs = ls_eq-bukrs.
  cs-daufn  = ls_eq-daufn.
  cs-ebeln  = ls_eq-ebeln.
  cs-asstxt = ls_eq-eqktx.
  cs-depdt  = ls_eq-datab.
  IF ls_eq-datbi <> gc_open_date.
    cs-reldt = ls_eq-datbi.
  ENDIF.

* IHC / Hire
  IF cs-ownhr = gc_hired.
    IF cs-ebeln IS INITIAL.
      IF iv_log = abap_true.
        CONCATENATE 'Hired equipment' lv_ext 'has no PO (ZZITO_PO_NUM) - hire cost not fetched'
          INTO lv_txt SEPARATED BY space.
        PERFORM add_log USING iv_row 'W' lv_txt.
      ENDIF.
    ELSE.
      PERFORM get_hire USING cs-ebeln gv_mon_from gv_mon_to CHANGING cs-ac_ihc.
      PERFORM get_hire USING cs-ebeln gv_itd_from gv_mon_to CHANGING cs-it_ihc.
    ENDIF.
  ELSEIF cs-anlnr IS INITIAL.
    IF iv_log = abap_true.
      CONCATENATE 'Equipment' lv_ext 'has no asset - IHC not fetched'
        INTO lv_txt SEPARATED BY space.
      PERFORM add_log USING iv_row 'W' lv_txt.
    ENDIF.
  ELSE.
    PERFORM get_ihc USING cs-abukrs cs-anlnr cs-anln2 gv_mon_from gv_mon_to CHANGING cs-ac_ihc.
    PERFORM get_ihc USING cs-abukrs cs-anlnr cs-anln2 gv_itd_from gv_mon_to CHANGING cs-it_ihc.
  ENDIF.

* Operator (OPEN POINT - see FORM get_operator)
  PERFORM get_operator USING cs-equnr gv_mon_from gv_mon_to CHANGING cs-ac_opr.
  PERFORM get_operator USING cs-equnr gv_itd_from gv_mon_to CHANGING cs-it_opr.

* Fuel: KOC4 actual debits on the standing order, calendar month
  IF cs-daufn IS NOT INITIAL.
    PERFORM get_fuel USING cs-daufn gv_cal_from gv_cal_to CHANGING cs-ac_fuel.
    PERFORM get_fuel USING cs-daufn gv_itd_from gv_cal_to CHANGING cs-it_fuel.
  ELSEIF iv_log = abap_true.
    CONCATENATE 'Equipment' lv_ext 'has no standing order (DAUFN) - fuel cost not fetched'
      INTO lv_txt SEPARATED BY space.
    PERFORM add_log USING iv_row 'W' lv_txt.
  ENDIF.

* Utilization actual (OPEN POINT - see FORM get_util)
  PERFORM get_util USING cs-equnr gv_mon_from gv_mon_to CHANGING cs-utlac.

  PERFORM recalc CHANGING cs.
ENDFORM.

*----------------------------------------------------------------------*
* Own / Lease: ZFI_IHC-IHCVALINR by BUKRS, ANLNR, ANLUN for the period
* SBEGDA (26th of previous month) .. EENDDA (25th of month) - spec R1
*----------------------------------------------------------------------*
FORM get_ihc USING iv_bukrs TYPE bukrs
                   iv_anln1 TYPE anln1
                   iv_anln2 TYPE anln2
                   iv_from  TYPE d
                   iv_to    TYPE d
             CHANGING cv    TYPE zps_t_fr_cst-ihc.
  DATA lv_sum TYPE p LENGTH 16 DECIMALS 2.
  CLEAR cv.
  SELECT SUM( ihcvalinr ) FROM zfi_ihc INTO lv_sum
    WHERE bukrs  = iv_bukrs
      AND anln1  = iv_anln1
      AND anln2  = iv_anln2
      AND sbegda >= iv_from
      AND eendda <= iv_to.
  cv = lv_sum.
ENDFORM.

*----------------------------------------------------------------------*
* Hired equipment: accepted service entry sheets (ML84) on the PO
* CONFIRM: ESSR posting date field (BUDAT) / acceptance flag (KZABN)
*----------------------------------------------------------------------*
FORM get_hire USING iv_ebeln TYPE ebeln
                    iv_from  TYPE d
                    iv_to    TYPE d
              CHANGING cv    TYPE zps_t_fr_cst-ihc.
  DATA lv_sum TYPE p LENGTH 16 DECIMALS 2.
  CLEAR cv.
  SELECT SUM( lwert ) FROM essr INTO lv_sum
    WHERE ebeln = iv_ebeln
      AND kzabn = abap_true
      AND loekz = space
      AND budat BETWEEN iv_from AND iv_to.
  cv = lv_sum.
ENDFORM.

*----------------------------------------------------------------------*
* Operator cost - OPEN POINT, returns 0 until ZPM_LOG logic is agreed
*----------------------------------------------------------------------*
FORM get_operator USING iv_equnr TYPE equnr
                        iv_from  TYPE d
                        iv_to    TYPE d
                  CHANGING cv    TYPE zps_t_fr_cst-opr.
  CLEAR cv.
  IF iv_equnr IS INITIAL OR iv_from > iv_to.
    RETURN.
  ENDIF.
* OPEN POINT (highlighted in spec R1): operator mapped to the equipment,
* salary cost for the period from ZPM_LOG - table fields to be confirmed.
* Template once confirmed:
*   DATA lv_sum TYPE p LENGTH 16 DECIMALS 2.
*   SELECT SUM( oprcost ) FROM zpm_log INTO lv_sum
*     WHERE equnr = iv_equnr
*       AND logdt BETWEEN iv_from AND iv_to.
*   cv = lv_sum.
ENDFORM.

*----------------------------------------------------------------------*
* Fuel: actual cost debits (KOC4 "Actual Cost Debit") on the standing
* order, CO area currency.
* Restricted to cost elements in TVARVC ZPS_T_FR_FUEL_KSTAR if maintained.
*----------------------------------------------------------------------*
FORM get_fuel USING iv_aufnr TYPE aufnr
                    iv_from  TYPE d
                    iv_to    TYPE d
              CHANGING cv    TYPE zps_t_fr_cst-fuel.
  DATA: lv_sum   TYPE p LENGTH 16 DECIMALS 2,
        lv_objnr TYPE j_objnr.
  CLEAR cv.
  CONCATENATE 'OR' iv_aufnr INTO lv_objnr.
  SELECT SUM( p~wkgbtr ) FROM coep AS p
    INNER JOIN cobk AS k ON k~kokrs = p~kokrs AND k~belnr = p~belnr
    INTO lv_sum
    WHERE p~objnr = lv_objnr
      AND p~wrttp = '04'
      AND p~beknz = 'S'
      AND p~kstar IN gr_fuel
      AND k~budat BETWEEN iv_from AND iv_to.
  cv = lv_sum.
ENDFORM.

*----------------------------------------------------------------------*
* Utilization actual - OPEN POINT, returns 0 until ZPM_AVUR logic is agreed
*----------------------------------------------------------------------*
FORM get_util USING iv_equnr TYPE equnr
                    iv_from  TYPE d
                    iv_to    TYPE d
              CHANGING cv    TYPE zps_t_fr_itm-utlac.
  CLEAR cv.
  IF iv_equnr IS INITIAL OR iv_from > iv_to.
    RETURN.
  ENDIF.
* OPEN POINT (spec R1): ZPM_AVUR is a report transaction ("use SWERK,
* derived from the actual deployment period and Nos"). Options once the
* business confirms the figure to take:
*   a) read the table ZPM_AVUR reports from, with SWERK = PROJ-WERKS,
*      EQUNR and the period, or
*   b) SUBMIT <report of ZPM_AVUR> WITH ... EXPORTING LIST TO MEMORY
*      AND RETURN, then LIST_FROM_MEMORY and pick the equipment's line.
ENDFORM.

*----------------------------------------------------------------------*
* Load a version: ZPS_T_FR_ITM + ZPS_T_FR_CST -> CT_LINE
*----------------------------------------------------------------------*
FORM load_version USING iv_versn TYPE zps_t_fr_hdr-versn CHANGING ct_line TYPE ty_t_line.
  DATA: lt_itm TYPE STANDARD TABLE OF zps_t_fr_itm,
        ls_itm TYPE zps_t_fr_itm,
        lt_cst TYPE SORTED TABLE OF zps_t_fr_cst WITH NON-UNIQUE KEY linid cstyp,
        ls_cst TYPE zps_t_fr_cst,
        ls_ln  TYPE ty_line.

  CLEAR ct_line.
  SELECT * FROM zps_t_fr_itm INTO TABLE lt_itm
    WHERE pspid = gs_proj-pspid AND versn = iv_versn.
  SELECT * FROM zps_t_fr_cst INTO TABLE lt_cst
    WHERE pspid = gs_proj-pspid AND versn = iv_versn.
  SORT lt_itm BY seqnr linid.

  LOOP AT lt_itm INTO ls_itm.
    CLEAR ls_ln.
    MOVE-CORRESPONDING ls_itm TO ls_ln.
    LOOP AT lt_cst INTO ls_cst WHERE linid = ls_itm-linid.
      CASE ls_cst-cstyp.
        WHEN gc_cst_plan.
          ls_ln-pl_ihc = ls_cst-ihc. ls_ln-pl_opr = ls_cst-opr. ls_ln-pl_fuel = ls_cst-fuel.
        WHEN gc_cst_act.
          ls_ln-ac_ihc = ls_cst-ihc. ls_ln-ac_opr = ls_cst-opr. ls_ln-ac_fuel = ls_cst-fuel.
        WHEN gc_cst_itd.
          ls_ln-it_ihc = ls_cst-ihc. ls_ln-it_opr = ls_cst-opr. ls_ln-it_fuel = ls_cst-fuel.
      ENDCASE.
    ENDLOOP.
    PERFORM class_text USING ls_ln-class CHANGING ls_ln-clstxt.
    PERFORM eqart_text USING ls_ln-eqart CHANGING ls_ln-eqtxt.
    APPEND ls_ln TO ct_line.
  ENDLOOP.
ENDFORM.

*----------------------------------------------------------------------*
* Is the line covered by the download filter (Own/Hired, period)?
*----------------------------------------------------------------------*
FORM in_scope USING is TYPE ty_line
                    iv_ownhr TYPE zps_t_fr_itm-ownhr
                    iv_perfr TYPE spmon
                    iv_perto TYPE spmon
              CHANGING cv TYPE abap_bool.
  DATA: lv_wfrom TYPE d,
        lv_wto   TYPE d,
        lv_lfrom TYPE d,
        lv_lto   TYPE d,
        lv_to    TYPE spmon.

  cv = abap_true.
  IF iv_ownhr IS NOT INITIAL AND is-ownhr <> iv_ownhr.
    cv = abap_false.
    RETURN.
  ENDIF.
  IF iv_perfr IS INITIAL.
    RETURN.
  ENDIF.

  lv_to = iv_perto.
  IF lv_to IS INITIAL.
    lv_to = '999912'.
  ENDIF.
  CONCATENATE iv_perfr '01' INTO lv_wfrom.
  PERFORM last_day USING lv_to CHANGING lv_wto.

* revised plan wins over plan; undated lines are always shown
  IF is-rpfrm IS NOT INITIAL OR is-rpto IS NOT INITIAL.
    lv_lfrom = is-rpfrm. lv_lto = is-rpto.
  ELSE.
    lv_lfrom = is-plfrm. lv_lto = is-plto.
  ENDIF.
  IF lv_lfrom IS INITIAL AND lv_lto IS INITIAL.
    RETURN.
  ENDIF.
  IF lv_lfrom IS INITIAL. lv_lfrom = '19000101'. ENDIF.
  IF lv_lto   IS INITIAL. lv_lto   = gc_open_date. ENDIF.
  IF lv_lfrom > lv_wto OR lv_lto < lv_wfrom.
    cv = abap_false.
  ENDIF.
ENDFORM.

FORM last_day USING iv_spmon TYPE spmon CHANGING cv_d TYPE d.
  DATA: lv_y  TYPE i, lv_m TYPE i, lv_n TYPE n LENGTH 2, lv_yy TYPE n LENGTH 4.
  IF iv_spmon = '999912'.
    cv_d = gc_open_date.
    RETURN.
  ENDIF.
  lv_y = iv_spmon(4).
  lv_m = iv_spmon+4(2).
  IF lv_m = 12.
    lv_m = 1. lv_y = lv_y + 1.
  ELSE.
    lv_m = lv_m + 1.
  ENDIF.
  lv_n = lv_m. lv_yy = lv_y.
  CONCATENATE lv_yy lv_n '01' INTO cv_d.
  cv_d = cv_d - 1.
ENDFORM.

*======================================================================*
*  DOWNLOAD
*======================================================================*
FORM download.
  DATA: lv_ok  TYPE abap_bool,
        lv_upd TYPE abap_bool,
        lv_in  TYPE abap_bool,
        lv_x   TYPE xstring,
        lv_txt TYPE string,
        lt_all TYPE ty_t_line,
        ls_ln  TYPE ty_line.

  PERFORM auth_check USING '03' space CHANGING lv_ok.
  IF lv_ok = abap_false.
    MESSAGE 'No authorisation to display the fleet schedule of this profit center' TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.
  PERFORM auth_check USING '02' space CHANGING lv_upd.

  IF p_file IS INITIAL AND gv_webgui = abap_false.
    PERFORM f4_file.
    IF p_file IS INITIAL.
      MESSAGE 'Enter a file name' TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.
  ENDIF.

* versions
  SELECT MAX( versn ) FROM zps_t_fr_hdr INTO gv_latest
    WHERE pspid = gs_proj-pspid.
  IF p_versn IS NOT INITIAL.
    SELECT SINGLE * FROM zps_t_fr_hdr INTO gs_hdr
      WHERE pspid = gs_proj-pspid AND versn = p_versn.
    IF sy-subrc <> 0.
      MESSAGE 'Version not found for this project' TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.
    gv_versn = p_versn.
  ELSEIF gv_latest IS NOT INITIAL.
    SELECT SINGLE * FROM zps_t_fr_hdr INTO gs_hdr
      WHERE pspid = gs_proj-pspid AND versn = gv_latest.
    gv_versn = gv_latest.
  ELSE.
    CLEAR: gs_hdr, gv_versn.
  ENDIF.

  IF gv_versn IS INITIAL.
    gv_mode = gc_mode_create.
  ELSEIF gv_versn < gv_latest.
    gv_mode = gc_mode_display.
  ELSE.
    gv_mode = gc_mode_maintain.
  ENDIF.
  IF lv_upd = abap_false.
    gv_mode = gc_mode_display.
  ENDIF.

* reporting month and filter
  IF gv_mode = gc_mode_display AND gv_versn IS NOT INITIAL AND gv_versn < gv_latest.
    gv_spmon = gs_hdr-spmon.             " older version shown as saved
  ELSE.
    gv_spmon = p_perto.
  ENDIF.
  gv_perfr = p_perfr.
  gv_perto = p_perto.
  gv_ownhr = p_ownhr.
  PERFORM set_windows.

* header values
  IF gv_versn IS NOT INITIAL.
    gv_expcd  = gs_hdr-expcd.
    gv_sncost = gs_hdr-sncost.
  ELSE.
    gv_expcd  = gs_proj-plsez.
    CLEAR gv_sncost.
  ENDIF.

  PERFORM get_lists.

* lines
  CLEAR gt_line.
  IF gv_versn IS NOT INITIAL.
    PERFORM load_version USING gv_versn CHANGING lt_all.
    LOOP AT lt_all INTO ls_ln.
      PERFORM in_scope USING ls_ln gv_ownhr gv_perfr gv_perto CHANGING lv_in.
      IF lv_in = abap_true.
        APPEND ls_ln TO gt_line.
      ENDIF.
    ENDLOOP.
  ENDIF.

* refresh SAP values for the reporting month (not for old versions)
  IF NOT ( gv_versn IS NOT INITIAL AND gv_versn < gv_latest ).
    LOOP AT gt_line INTO ls_ln.
      PERFORM fetch_sap USING 0 abap_false CHANGING ls_ln.
      MODIFY gt_line FROM ls_ln.
    ENDLOOP.
  ENDIF.

  PERFORM complete_lists.
  PERFORM build_sheet_cells.
  PERFORM build_xlsx CHANGING lv_x.
  PERFORM send_file USING lv_x CHANGING lv_ok.

  IF lv_ok = abap_true.
    CASE gv_mode.
      WHEN gc_mode_create.
        lv_txt = 'Template downloaded - new schedule (no version yet)'.
      WHEN gc_mode_display.
        CONCATENATE 'Version' gv_versn 'downloaded for display only (cannot be uploaded)'
          INTO lv_txt SEPARATED BY space.
      WHEN OTHERS.
        CONCATENATE 'Version' gv_versn 'downloaded for maintenance' INTO lv_txt SEPARATED BY space.
    ENDCASE.
    MESSAGE lv_txt TYPE 'S'.
  ENDIF.
ENDFORM.

*----------------------------------------------------------------------*
* Equipment already on the lines but no longer in the project plant list
* (released, moved) is added to the lookup list, so asset code, sub-asset
* and description still show in Excel
*----------------------------------------------------------------------*
FORM complete_lists.
  DATA: ls_ln TYPE ty_line,
        ls_uq TYPE ty_equniq,
        lv_k  TYPE string.
  LOOP AT gt_line INTO ls_ln WHERE equnr IS NOT INITIAL.
    PERFORM alpha_out USING ls_ln-equnr CHANGING lv_k.
    READ TABLE gt_equniq TRANSPORTING NO FIELDS WITH KEY equnr = lv_k.
    IF sy-subrc <> 0.
      CLEAR ls_uq.
      ls_uq-equnr = lv_k.
      PERFORM asset_key USING ls_ln-anlnr '0000' CHANGING ls_uq-anln.
      PERFORM sub_text USING ls_ln-anlnr ls_ln-anln2 CHANGING ls_uq-anlun.
      ls_uq-eqktx = ls_ln-asstxt.
      PERFORM ownhr_text USING ls_ln-ownhr CHANGING ls_uq-own.
      APPEND ls_uq TO gt_equniq.
    ENDIF.
  ENDLOOP.
ENDFORM.

*----------------------------------------------------------------------*
* Cell buffer. Formulas are stored without the leading '='.
*----------------------------------------------------------------------*
FORM put USING    iv_row  TYPE i
                  iv_col  TYPE i
                  iv_kind TYPE c
                  iv_val  TYPE any
         CHANGING ct      TYPE ty_t_cell.
  DATA ls_cell TYPE ty_cell.
  ls_cell-row   = iv_row.
  ls_cell-col   = iv_col.
  ls_cell-kind  = iv_kind.
  ls_cell-value = iv_val.
  CONDENSE ls_cell-value.
  IF ls_cell-value IS INITIAL.
    RETURN.
  ENDIF.
  IF iv_kind = gc_k_date AND ( ls_cell-value CO '0' OR ls_cell-value = gc_open_date ).
    RETURN.
  ENDIF.
  DELETE TABLE ct WITH TABLE KEY row = iv_row col = iv_col.
  INSERT ls_cell INTO TABLE ct.
ENDFORM.

FORM put_amt USING iv_row TYPE i iv_col TYPE i iv_amt TYPE any.
  DATA lv TYPE string.
  IF iv_amt IS INITIAL.
    RETURN.
  ENDIF.
  PERFORM num2str USING iv_amt CHANGING lv.
  PERFORM put USING iv_row iv_col gc_k_num lv CHANGING gt_out.
ENDFORM.

*----------------------------------------------------------------------*
* Build every cell of the main sheet in GT_OUT
*----------------------------------------------------------------------*
FORM build_sheet_cells.
  DATA: ls_ln  TYPE ty_line,
        ls_col TYPE ty_col,
        lv_r   TYPE i,
        lv_n   TYPE i,
        lv_s   TYPE string,
        lv_d   TYPE d.

  CLEAR: gt_out, gt_merge.

* --- header block --------------------------------------------------
  PERFORM put USING 2 1 gc_k_str gv_company CHANGING gt_out.
  PERFORM add_merge USING 1 2 gc_c_rem 2.
  PERFORM put USING 3 1 gc_k_str gv_bu CHANGING gt_out.
  PERFORM add_merge USING 1 3 gc_c_rem 3.
  PERFORM put USING gc_r_month gc_c_cbal gc_k_str 'Month-Year' CHANGING gt_out.
  CONCATENATE gv_spmon '01' INTO lv_d.
  PERFORM put USING gc_r_month gc_c_rem gc_k_date lv_d CHANGING gt_out.
  PERFORM put USING 5 1 gc_k_str 'SCHEDULE OF FLEET & RESOURCES' CHANGING gt_out.
  PERFORM add_merge USING 1 5 gc_c_rem 5.

  PERFORM put USING gc_r_job  1 gc_k_str 'Job No :'          CHANGING gt_out.
  PERFORM put USING gc_r_job  gc_c_jobval gc_k_str gv_ext_pspid  CHANGING gt_out.
  PERFORM put USING gc_r_desc 1 gc_k_str 'Job Description :' CHANGING gt_out.
  PERFORM put USING gc_r_desc gc_c_jobval gc_k_str gs_proj-post1 CHANGING gt_out.
  PERFORM put USING gc_r_cli  1 gc_k_str 'Client :'          CHANGING gt_out.
  PERFORM put USING gc_r_cli  gc_c_jobval gc_k_str gv_client    CHANGING gt_out.
  PERFORM add_merge USING 1 gc_r_job  2 gc_r_job.
  PERFORM add_merge USING 1 gc_r_desc 2 gc_r_desc.
  PERFORM add_merge USING 1 gc_r_cli  2 gc_r_cli.
  PERFORM add_merge USING gc_c_jobval gc_r_job  gc_c_jobend gc_r_job.
  PERFORM add_merge USING gc_c_jobval gc_r_desc gc_c_jobend gc_r_desc.
  PERFORM add_merge USING gc_c_jobval gc_r_cli  gc_c_jobend gc_r_cli.

* legend (box in F, text in G:I)
  PERFORM put USING gc_r_job  gc_c_legtxt gc_k_str 'Data Entry'                                CHANGING gt_out.
  PERFORM put USING gc_r_desc gc_c_legtxt gc_k_str 'Data to be fetched from SAP ( Any Module)' CHANGING gt_out.
  PERFORM put USING gc_r_cli  gc_c_legtxt gc_k_str 'Formula'                                   CHANGING gt_out.
  PERFORM add_merge USING gc_c_legtxt gc_r_job  gc_c_legend gc_r_job.
  PERFORM add_merge USING gc_c_legtxt gc_r_desc gc_c_legend gc_r_desc.
  PERFORM add_merge USING gc_c_legtxt gc_r_cli  gc_c_legend gc_r_cli.

* contractual dates (labels AD:AG, values AH:AI)
  PERFORM put USING gc_r_job  gc_c_hlab gc_k_str 'Contractual Start Date'        CHANGING gt_out.
  PERFORM put USING gc_r_desc gc_c_hlab gc_k_str 'Contractual Completion Date'   CHANGING gt_out.
  PERFORM put USING gc_r_cli  gc_c_hlab gc_k_str 'Expected Completion Date'      CHANGING gt_out.
  PERFORM put USING gc_r_sanc gc_c_hlab gc_k_str 'Sanctioned / Contracted Cost'  CHANGING gt_out.
  PERFORM put USING gc_r_job  gc_c_hval gc_k_date gs_proj-plfaz CHANGING gt_out.
  PERFORM put USING gc_r_desc gc_c_hval gc_k_date gs_proj-plsez CHANGING gt_out.
  PERFORM put USING gc_r_cli  gc_c_hval gc_k_date gv_expcd      CHANGING gt_out.
  IF gv_sncost IS NOT INITIAL.
    PERFORM num2str USING gv_sncost CHANGING lv_s.
    PERFORM put USING gc_r_sanc gc_c_hval gc_k_num lv_s CHANGING gt_out.
  ENDIF.
  lv_r = gc_r_job.
  DO 4 TIMES.
    PERFORM add_merge USING gc_c_hlab lv_r gc_c_hlabe lv_r.
    PERFORM add_merge USING gc_c_hval lv_r gc_c_hvale lv_r.
    lv_r = lv_r + 1.
  ENDDO.

* --- column group captions (row 11) ---------------------------------
  PERFORM put USING gc_r_grp gc_c_pihc gc_k_str 'Planned Cost Per Month' CHANGING gt_out.
  PERFORM add_merge USING gc_c_pihc gc_r_grp gc_c_ptot gc_r_grp.
  PERFORM put USING gc_r_grp gc_c_aihc gc_k_str 'Actual Cost Per Month'  CHANGING gt_out.
  PERFORM add_merge USING gc_c_aihc gc_r_grp gc_c_atot gc_r_grp.
  PERFORM put USING gc_r_grp gc_c_pfrm gc_k_str 'Plan'                   CHANGING gt_out.
  PERFORM add_merge USING gc_c_pfrm gc_r_grp gc_c_pmm gc_r_grp.
  PERFORM put USING gc_r_grp gc_c_rfrm gc_k_str 'Rev. Plan'              CHANGING gt_out.
  PERFORM add_merge USING gc_c_rfrm gc_r_grp gc_c_rmm gc_r_grp.
  PERFORM put USING gc_r_grp gc_c_upl  gc_k_str 'Utilization in %'       CHANGING gt_out.
  PERFORM add_merge USING gc_c_upl gc_r_grp gc_c_uac gc_r_grp.
  PERFORM put USING gc_r_grp gc_c_ihir gc_k_str 'ITD Cost'               CHANGING gt_out.
  PERFORM add_merge USING gc_c_ihir gc_r_grp gc_c_itot gc_r_grp.
  PERFORM put USING gc_r_grp gc_c_cpl  gc_k_str 'Cost'                   CHANGING gt_out.
  PERFORM add_merge USING gc_c_cpl gc_r_grp gc_c_cbal gc_r_grp.

* --- table header (row 12) ------------------------------------------
  LOOP AT gt_col INTO ls_col.
    PERFORM put USING gc_r_head ls_col-col gc_k_str ls_col-name CHANGING gt_out.
  ENDLOOP.

* --- resource lines ---------------------------------------------------
  lv_r = gc_r_head.
  LOOP AT gt_line INTO ls_ln.
    lv_r = lv_r + 1.
    PERFORM line_cells USING lv_r ls_ln.
  ENDLOOP.

* spare rows (not in display mode); a table needs at least one row
  IF gv_mode <> gc_mode_display.
    lv_n = p_spare.
    IF gt_line IS INITIAL AND lv_n < gc_new_rows.
      lv_n = gc_new_rows.
    ENDIF.
    IF lv_n < 1.
      lv_n = 1.
    ENDIF.
  ELSEIF gt_line IS INITIAL.
    lv_n = 1.
  ELSE.
    lv_n = 0.
  ENDIF.
  DO lv_n TIMES.
    lv_r = lv_r + 1.
    CLEAR ls_ln.
    PERFORM line_cells USING lv_r ls_ln.
  ENDDO.
  gv_lastrow = lv_r.

* --- totals row (table totals row) -----------------------------------
  gv_totrow = gv_lastrow + 1.
  PERFORM put USING gv_totrow gc_c_sno gc_k_str 'Total' CHANGING gt_out.
  LOOP AT gt_col INTO ls_col WHERE tot = 'S'.
    CONCATENATE 'SUBTOTAL(109,' gc_table '[' ls_col-name '])' INTO lv_s.
    PERFORM put USING gv_totrow ls_col-col gc_k_form lv_s CHANGING gt_out.
  ENDLOOP.

* --- signatures -------------------------------------------------------
  gv_sigrow = gv_totrow + 4.
  PERFORM put USING gv_sigrow gc_c_eqart gc_k_str '(Planning Incharge)'   CHANGING gt_out.
  PERFORM put USING gv_sigrow gc_c_ownc gc_k_str '(Sr. Planning Manager)' CHANGING gt_out.
  PERFORM put USING gv_sigrow gc_c_cbal gc_k_str '(Project Manager)'      CHANGING gt_out.
ENDFORM.

*----------------------------------------------------------------------*
FORM line_cells USING iv_r TYPE i is TYPE ty_line.
  DATA: ls_col TYPE ty_col,
        lv_s   TYPE string.

* formula columns are written in every row (calculated columns),
* incl. Qty = 1 and the asset / sub-asset / description lookups
  LOOP AT gt_col INTO ls_col WHERE calc IS NOT INITIAL.
    PERFORM put USING iv_r ls_col-col gc_k_form ls_col-calc CHANGING gt_out.
  ENDLOOP.
  IF is-linid IS INITIAL.
    RETURN.
  ENDIF.

  PERFORM put USING iv_r gc_c_eqart gc_k_str is-eqtxt  CHANGING gt_out.
  PERFORM put USING iv_r gc_c_class gc_k_str is-clstxt CHANGING gt_out.
  IF is-equnr IS NOT INITIAL.
    PERFORM alpha_out USING is-equnr CHANGING lv_s.
    PERFORM put USING iv_r gc_c_equnr gc_k_str lv_s CHANGING gt_out.
  ENDIF.
  PERFORM avl_text USING is-avlrq CHANGING lv_s.
  PERFORM put USING iv_r gc_c_avl  gc_k_str lv_s       CHANGING gt_out.
  PERFORM put_amt USING iv_r gc_c_qty is-qty.
  PERFORM put USING iv_r gc_c_ownc gc_k_str is-owncd   CHANGING gt_out.

  PERFORM put_amt USING iv_r gc_c_pihc is-pl_ihc.
  PERFORM put_amt USING iv_r gc_c_popr is-pl_opr.
  PERFORM put_amt USING iv_r gc_c_pful is-pl_fuel.
  PERFORM put_amt USING iv_r gc_c_aihc is-ac_ihc.
  PERFORM put_amt USING iv_r gc_c_aopr is-ac_opr.
  PERFORM put_amt USING iv_r gc_c_aful is-ac_fuel.

  PERFORM put USING iv_r gc_c_pfrm gc_k_date is-plfrm CHANGING gt_out.
  PERFORM put USING iv_r gc_c_pto  gc_k_date is-plto  CHANGING gt_out.
  PERFORM put USING iv_r gc_c_rfrm gc_k_date is-rpfrm CHANGING gt_out.
  PERFORM put USING iv_r gc_c_rto  gc_k_date is-rpto  CHANGING gt_out.

  PERFORM put_amt USING iv_r gc_c_uac is-utlac.
  PERFORM put USING iv_r gc_c_dep gc_k_date is-depdt CHANGING gt_out.
  PERFORM put USING iv_r gc_c_rel gc_k_date is-reldt CHANGING gt_out.
  PERFORM put_amt USING iv_r gc_c_ihir is-it_ihc.
  PERFORM put_amt USING iv_r gc_c_iopr is-it_opr.
  PERFORM put_amt USING iv_r gc_c_iful is-it_fuel.

  PERFORM put USING iv_r gc_c_rem gc_k_str is-remark CHANGING gt_out.
  lv_s = is-linid.
  PERFORM put USING iv_r gc_c_lin gc_k_str lv_s CHANGING gt_out.
ENDFORM.

*======================================================================*
*  XLSX WRITER
*======================================================================*
FORM build_xlsx CHANGING cv_zip TYPE xstring.
  DATA: lo_zip  TYPE REF TO cl_abap_zip,
        lt_list TYPE ty_t_cell,
        lt_ctl  TYPE ty_t_cell,
        lv_xml  TYPE string,
        lv_name TYPE string,
        lv_defs TYPE string.

  PERFORM build_list_cells CHANGING lt_list lv_defs.
  PERFORM build_ctl_cells CHANGING lt_ctl.

  CREATE OBJECT lo_zip.

  PERFORM xml_content_types CHANGING lv_xml.
  PERFORM add_zip USING lo_zip '[Content_Types].xml' lv_xml.

  CONCATENATE '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
    '<Relationships xmlns="' gc_ns_pkg '">'
    '<Relationship Id="rId1" Type="' gc_ns_rel '/officeDocument" Target="xl/workbook.xml"/>'
    '</Relationships>' INTO lv_xml.
  PERFORM add_zip USING lo_zip '_rels/.rels' lv_xml.

  PERFORM xml_escape USING gc_sheet_main CHANGING lv_name.
  CONCATENATE '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
    '<workbook xmlns="' gc_ns_main '" xmlns:r="' gc_ns_rel '">'
    '<workbookProtection workbookPassword="' gc_pwd_hash '" lockStructure="1"/>'
    '<bookViews><workbookView activeTab="0"/></bookViews>'
    '<sheets>'
    '<sheet name="' lv_name '" sheetId="1" r:id="rId1"/>'
    '<sheet name="' gc_sheet_list '" sheetId="2" state="veryHidden" r:id="rId2"/>'
    '<sheet name="' gc_sheet_ctrl '" sheetId="3" state="veryHidden" r:id="rId3"/>'
    '</sheets>'
    lv_defs
    '<calcPr calcId="0" fullCalcOnLoad="1"/>'
    '</workbook>' INTO lv_xml.
  PERFORM add_zip USING lo_zip 'xl/workbook.xml' lv_xml.

  CONCATENATE '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
    '<Relationships xmlns="' gc_ns_pkg '">'
    '<Relationship Id="rId1" Type="' gc_ns_rel '/worksheet" Target="worksheets/sheet1.xml"/>'
    '<Relationship Id="rId2" Type="' gc_ns_rel '/worksheet" Target="worksheets/sheet2.xml"/>'
    '<Relationship Id="rId3" Type="' gc_ns_rel '/worksheet" Target="worksheets/sheet3.xml"/>'
    '<Relationship Id="rId4" Type="' gc_ns_rel '/styles" Target="styles.xml"/>'
    '</Relationships>' INTO lv_xml.
  PERFORM add_zip USING lo_zip 'xl/_rels/workbook.xml.rels' lv_xml.

  CONCATENATE '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
    '<Relationships xmlns="' gc_ns_pkg '">'
    '<Relationship Id="rId1" Type="' gc_ns_rel '/table" Target="../tables/table1.xml"/>'
    '</Relationships>' INTO lv_xml.
  PERFORM add_zip USING lo_zip 'xl/worksheets/_rels/sheet1.xml.rels' lv_xml.

  PERFORM xml_styles CHANGING lv_xml.
  PERFORM add_zip USING lo_zip 'xl/styles.xml' lv_xml.

  PERFORM xml_main_sheet CHANGING lv_xml.
  PERFORM add_zip USING lo_zip 'xl/worksheets/sheet1.xml' lv_xml.

  PERFORM xml_table CHANGING lv_xml.
  PERFORM add_zip USING lo_zip 'xl/tables/table1.xml' lv_xml.

  PERFORM xml_simple_sheet USING lt_list '28' CHANGING lv_xml.
  PERFORM add_zip USING lo_zip 'xl/worksheets/sheet2.xml' lv_xml.

  PERFORM xml_simple_sheet USING lt_ctl '14' CHANGING lv_xml.
  PERFORM add_zip USING lo_zip 'xl/worksheets/sheet3.xml' lv_xml.

  cv_zip = lo_zip->save( ).
ENDFORM.

*----------------------------------------------------------------------*
* LISTS sheet (dropdown sources) + defined names
*   A Own/Hired  B Avl/Req/Sur  C Equipment Group  (D unused)
*   E Equipment Class   F:G class -> equipment (dependent dropdown)
*   H:L equipment -> asset, sub-asset, description, Own/Hired (lookups)
*----------------------------------------------------------------------*
FORM build_list_cells CHANGING ct TYPE ty_t_cell cv_defs TYPE string.
  DATA: lv_s    TYPE string,
        lv_r    TYPE i,
        ls_cl   TYPE ty_class,
        ls_ce   TYPE ty_clseq,
        ls_uq   TYPE ty_equniq,
        ls_ea   TYPE ty_eqart,
        lt_name TYPE string_table.

  CLEAR: ct, cv_defs.
  PERFORM put USING 1 1 gc_k_str 'Own/Hired'     CHANGING ct.
  PERFORM put USING 2 1 gc_k_str 'Own'           CHANGING ct.
  PERFORM put USING 3 1 gc_k_str 'Lease'         CHANGING ct.
  PERFORM put USING 4 1 gc_k_str 'Hired'         CHANGING ct.
  PERFORM add_name USING 'L_OWN' 1 4 CHANGING lt_name.

  PERFORM put USING 1 2 gc_k_str 'Avl/Req/Sur'   CHANGING ct.
  PERFORM put USING 2 2 gc_k_str 'Avl'           CHANGING ct.
  PERFORM put USING 3 2 gc_k_str 'Req'           CHANGING ct.
  PERFORM put USING 4 2 gc_k_str 'Sur'           CHANGING ct.
  PERFORM add_name USING 'L_AVL' 2 4 CHANGING lt_name.

* C: Equipment Group (object types)   D: not used
  PERFORM put USING 1 3 gc_k_str 'Equipment Group' CHANGING ct.
  lv_r = 1.
  LOOP AT gt_eqart INTO ls_ea.
    lv_r = lv_r + 1.
    PERFORM put USING lv_r 3 gc_k_str ls_ea-eartx CHANGING ct.
  ENDLOOP.
  IF lv_r > 1.
    PERFORM add_name USING 'L_EQART' 3 lv_r CHANGING lt_name.
  ENDIF.

* E: Equipment Class dropdown (KLAH type 002 / SWOR)
  PERFORM put USING 1 5 gc_k_str 'Equipment Class' CHANGING ct.
  lv_r = 1.
  LOOP AT gt_class INTO ls_cl.
    lv_r = lv_r + 1.
    PERFORM put USING lv_r 5 gc_k_str ls_cl-text CHANGING ct.
  ENDLOOP.
  IF lv_r > 1.
    PERFORM add_name USING 'L_CLASS' 5 lv_r CHANGING lt_name.
  ENDIF.

* F:G: class -> equipment, sorted by class (dependent dropdown on D)
  PERFORM put USING 1 6 gc_k_str 'Class'     CHANGING ct.
  PERFORM put USING 1 7 gc_k_str 'Equipment' CHANGING ct.
  lv_r = 1.
  LOOP AT gt_clseq INTO ls_ce.
    lv_r = lv_r + 1.
    PERFORM put USING lv_r 6 gc_k_str ls_ce-clstxt CHANGING ct.
    PERFORM put USING lv_r 7 gc_k_str ls_ce-equnr  CHANGING ct.
  ENDLOOP.

* H:L: equipment -> asset, sub-asset, description, Own/Hired (lookups)
  PERFORM put USING 1 8  gc_k_str 'Equipment'         CHANGING ct.
  PERFORM put USING 1 9  gc_k_str 'Asset'             CHANGING ct.
  PERFORM put USING 1 10 gc_k_str 'Sub-Asset'         CHANGING ct.
  PERFORM put USING 1 11 gc_k_str 'Asset Description' CHANGING ct.
  PERFORM put USING 1 12 gc_k_str 'Own/Hired'         CHANGING ct.
  lv_r = 1.
  LOOP AT gt_equniq INTO ls_uq.
    lv_r = lv_r + 1.
    PERFORM put USING lv_r 8  gc_k_str ls_uq-equnr CHANGING ct.
    PERFORM put USING lv_r 9  gc_k_str ls_uq-anln  CHANGING ct.
    PERFORM put USING lv_r 10 gc_k_str ls_uq-anlun CHANGING ct.
    PERFORM put USING lv_r 11 gc_k_str ls_uq-eqktx CHANGING ct.
    PERFORM put USING lv_r 12 gc_k_str ls_uq-own   CHANGING ct.
  ENDLOOP.

  CONCATENATE LINES OF lt_name INTO lv_s.
  CONCATENATE '<definedNames>' lv_s '</definedNames>' INTO cv_defs.
ENDFORM.

FORM add_name USING iv_name TYPE any iv_col TYPE i iv_last TYPE i
              CHANGING ct TYPE string_table.
  DATA: lv_c TYPE string,
        lv_n TYPE string,
        lv_x TYPE string.
  PERFORM col_letter USING iv_col CHANGING lv_c.
  lv_n = iv_last.
  CONDENSE lv_n.
  CONCATENATE '<definedName name="' iv_name '">' gc_sheet_list '!$' lv_c '$2:$' lv_c '$' lv_n
              '</definedName>' INTO lv_x.
  APPEND lv_x TO ct.
ENDFORM.

* is there a defined name for this list?
FORM has_list USING iv_name TYPE any CHANGING cv TYPE abap_bool.
  cv = abap_true.
  CASE iv_name.
    WHEN 'L_CLASS'. IF gt_class IS INITIAL. cv = abap_false. ENDIF.
    WHEN 'L_EQART'. IF gt_eqart IS INITIAL. cv = abap_false. ENDIF.
    WHEN 'EQUI'.    IF gt_clseq IS INITIAL. cv = abap_false. ENDIF.
  ENDCASE.
ENDFORM.

*----------------------------------------------------------------------*
* CONTROL sheet: marker, project, base version, reporting month,
* filter, mode, downloaded at/by
*----------------------------------------------------------------------*
FORM build_ctl_cells CHANGING ct TYPE ty_t_cell.
  DATA lv_s TYPE string.
  CLEAR ct.
  PERFORM put USING 1 1 gc_k_str gc_marker    CHANGING ct.
  PERFORM put USING 1 2 gc_k_str gv_ext_pspid CHANGING ct.
  lv_s = gv_versn.
  IF lv_s IS INITIAL.
    lv_s = '000'.
  ENDIF.
  PERFORM put USING 1 3 gc_k_str lv_s     CHANGING ct.
  lv_s = gv_spmon.
  PERFORM put USING 1 4 gc_k_str lv_s     CHANGING ct.
  lv_s = gv_perfr.
  IF gv_perfr IS INITIAL. CLEAR lv_s. ENDIF.
  PERFORM put USING 1 5 gc_k_str lv_s     CHANGING ct.
  lv_s = gv_perto.
  IF gv_perto IS INITIAL. CLEAR lv_s. ENDIF.
  PERFORM put USING 1 6 gc_k_str lv_s     CHANGING ct.
  PERFORM put USING 1 7 gc_k_str gv_ownhr CHANGING ct.
  PERFORM put USING 1 8 gc_k_str gv_mode  CHANGING ct.
  CONCATENATE sy-datum sy-uzeit sy-uname INTO lv_s SEPARATED BY space.
  PERFORM put USING 1 9 gc_k_str lv_s     CHANGING ct.
  PERFORM put USING 2 1 gc_k_str 'Do not change this sheet' CHANGING ct.
ENDFORM.

*----------------------------------------------------------------------*
FORM add_zip USING io_zip  TYPE REF TO cl_abap_zip
                   iv_name TYPE any
                   iv_xml  TYPE string.
  DATA: lo_conv TYPE REF TO cl_abap_conv_out_ce,
        lv_x    TYPE xstring,
        lv_name TYPE string.
  lo_conv = cl_abap_conv_out_ce=>create( encoding = 'UTF-8' ).
  lo_conv->write( data = iv_xml ).
  lv_x = lo_conv->get_buffer( ).
  lv_name = iv_name.
  io_zip->add( name = lv_name content = lv_x ).
ENDFORM.

*----------------------------------------------------------------------*
FORM xml_escape USING iv TYPE any CHANGING cv TYPE string.
  cv = iv.
  REPLACE ALL OCCURRENCES OF '&' IN cv WITH '&amp;'.
  REPLACE ALL OCCURRENCES OF '<' IN cv WITH '&lt;'.
  REPLACE ALL OCCURRENCES OF '>' IN cv WITH '&gt;'.
  REPLACE ALL OCCURRENCES OF '"' IN cv WITH '&quot;'.
  REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>horizontal_tab IN cv WITH ` `.
ENDFORM.


*----------------------------------------------------------------------*
* style of a table body cell from the column class / format
*----------------------------------------------------------------------*
FORM body_style USING is_col TYPE ty_col CHANGING cv TYPE i.
  CASE is_col-cls.
    WHEN gc_cls_entry.
      CASE is_col-fmt.
        WHEN gc_fmt_text. cv = gc_s_e_text.
        WHEN gc_fmt_date. cv = gc_s_e_date.
        WHEN gc_fmt_gen.  cv = gc_s_e_gen.
        WHEN OTHERS.      cv = gc_s_e_num.
      ENDCASE.
    WHEN gc_cls_sap.
      CASE is_col-fmt.
        WHEN gc_fmt_text. cv = gc_s_s_text.
        WHEN gc_fmt_date. cv = gc_s_s_date.
        WHEN gc_fmt_dec.  cv = gc_s_s_dec.
        WHEN OTHERS.      cv = gc_s_s_num.
      ENDCASE.
    WHEN gc_cls_white.
      cv = gc_s_w_entry.
    WHEN gc_cls_slist.
      cv = gc_s_s_list.
    WHEN gc_cls_slook.
      cv = gc_s_s_text.
    WHEN gc_cls_form.
      IF is_col-fmt = gc_fmt_gen.
        cv = gc_s_f_sno.
      ELSE.
        cv = gc_s_f_num.
      ENDIF.
    WHEN OTHERS.
      cv = gc_s_sys.
  ENDCASE.
ENDFORM.

* style of a header-block cell (rows 1-10)
FORM top_style USING iv_row TYPE i iv_col TYPE i CHANGING cv TYPE i.
  cv = gc_s_none.
  CASE iv_row.
    WHEN 2.
      cv = gc_s_company.
    WHEN 3 OR 5.
      cv = gc_s_title.
    WHEN gc_r_month.
      IF iv_col = gc_c_rem.
        cv = gc_s_month.
      ELSE.
        cv = gc_s_label.
      ENDIF.
    WHEN OTHERS.
      IF iv_col = 1 OR iv_col = gc_c_hlab.
        cv = gc_s_label.
      ELSEIF iv_col = gc_c_legbox.              " legend boxes
        CASE iv_row.
          WHEN gc_r_job.  cv = gc_s_leg_e.
          WHEN gc_r_desc. cv = gc_s_leg_s.
          WHEN gc_r_cli.  cv = gc_s_leg_f.
        ENDCASE.
      ELSEIF iv_col = gc_c_hval.
        CASE iv_row.
          WHEN gc_r_cli.  cv = gc_s_e_date.     " expected completion: entry
          WHEN gc_r_sanc. cv = gc_s_e_num.      " sanctioned cost: entry
          WHEN OTHERS.    cv = gc_s_hdate.
        ENDCASE.
      ELSEIF iv_col = gc_c_jobval.
        cv = gc_s_label.
      ENDIF.
  ENDCASE.
ENDFORM.

*----------------------------------------------------------------------*
FORM xml_cell USING    is_cell  TYPE ty_cell
                       iv_style TYPE i
              CHANGING ct_xml   TYPE string_table.
  DATA: lv_ref  TYPE string,
        lv_s    TYPE string,
        lv_v    TYPE string,
        lv_part TYPE string,
        lv_d    TYPE d,
        lv_base TYPE d VALUE '18991230',
        lv_days TYPE i.

  PERFORM cell_ref USING is_cell-col is_cell-row CHANGING lv_ref.
  lv_s = iv_style.
  CONDENSE lv_s.

  CASE is_cell-kind.
    WHEN gc_k_str.
      PERFORM xml_escape USING is_cell-value CHANGING lv_v.
      CONCATENATE '<c r="' lv_ref '" s="' lv_s '" t="inlineStr"><is><t xml:space="preserve">'
                  lv_v '</t></is></c>' INTO lv_part.
    WHEN gc_k_num.
      CONCATENATE '<c r="' lv_ref '" s="' lv_s '"><v>' is_cell-value '</v></c>' INTO lv_part.
    WHEN gc_k_date.
      lv_d = is_cell-value.
      lv_days = lv_d - lv_base.               " Excel serial date
      lv_v = lv_days.
      CONDENSE lv_v.
      CONCATENATE '<c r="' lv_ref '" s="' lv_s '"><v>' lv_v '</v></c>' INTO lv_part.
    WHEN gc_k_form.
      PERFORM xml_escape USING is_cell-value CHANGING lv_v.
      CONCATENATE '<c r="' lv_ref '" s="' lv_s '"><f>' lv_v '</f></c>' INTO lv_part.
    WHEN OTHERS.                               " empty, styled cell
      CONCATENATE '<c r="' lv_ref '" s="' lv_s '"/>' INTO lv_part.
  ENDCASE.
  APPEND lv_part TO ct_xml.
ENDFORM.

*----------------------------------------------------------------------*
FORM xml_main_sheet CHANGING cv TYPE string.
  DATA: lt_xml   TYPE string_table,
        ls_cell  TYPE ty_cell,
        ls_col   TYPE ty_col,
        lv_r     TYPE i,
        lv_style TYPE i,
        lv_rs    TYPE string,
        lv_cs    TYPE string,
        lv_part  TYPE string,
        lv_a     TYPE string,
        lv_n     TYPE string,
        lv_ok    TYPE abap_bool,
        lv_hid   TYPE string,
        lv_ht    TYPE string.

  CONCATENATE '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
    '<worksheet xmlns="' gc_ns_main '" xmlns:r="' gc_ns_rel '">'
    '<sheetPr><pageSetUpPr fitToPage="1"/></sheetPr>'
    '<sheetViews><sheetView tabSelected="1" zoomScale="85" workbookViewId="0">'
    '<pane xSplit="9" ySplit="12" topLeftCell="J13" activePane="bottomRight" state="frozen"/>'
    '<selection pane="topRight"/><selection pane="bottomLeft"/>'
    '<selection pane="bottomRight" activeCell="J13" sqref="J13"/>'
    '</sheetView></sheetViews>'
    '<sheetFormatPr defaultRowHeight="15"/>'
    '<cols>' INTO lv_part.
  APPEND lv_part TO lt_xml.
  LOOP AT gt_col INTO ls_col.
    lv_cs = ls_col-col. CONDENSE lv_cs.
    CLEAR lv_hid.
    IF ls_col-cls = gc_cls_sys.
      lv_hid = ' hidden="1"'.                       " Line ID
    ENDIF.
    CONCATENATE '<col min="' lv_cs '" max="' lv_cs '" width="' ls_col-width '" customWidth="1"' lv_hid '/>'
      INTO lv_part.
    APPEND lv_part TO lt_xml.
  ENDLOOP.
  APPEND '</cols><sheetData>' TO lt_xml.

  DO gv_sigrow TIMES.
    lv_r = sy-index.
    lv_rs = lv_r. CONDENSE lv_rs.

    CLEAR lv_ht.
    CASE lv_r.
      WHEN 2.          lv_ht = ' ht="23" customHeight="1"'.
      WHEN 5.          lv_ht = ' ht="21" customHeight="1"'.
      WHEN gc_r_head.  lv_ht = ' ht="45" customHeight="1"'.
    ENDCASE.
    CONCATENATE '<row r="' lv_rs '"' lv_ht '>' INTO lv_part.
    APPEND lv_part TO lt_xml.

    IF lv_r < gc_r_grp OR lv_r > gv_totrow.
*     header block / signatures: only filled cells (+ legend boxes)
      IF lv_r BETWEEN gc_r_job AND gc_r_cli.
        CLEAR ls_cell.
        ls_cell-row = lv_r. ls_cell-col = gc_c_legbox.
        INSERT ls_cell INTO TABLE gt_out.                 " no-op if present
      ENDIF.
      IF lv_r BETWEEN gc_r_cli AND gc_r_sanc.             " entry boxes
        CLEAR ls_cell.
        ls_cell-row = lv_r. ls_cell-col = gc_c_hval.
        INSERT ls_cell INTO TABLE gt_out.
      ENDIF.
      LOOP AT gt_out INTO ls_cell WHERE row = lv_r.
        IF lv_r > gv_totrow.
          lv_style = gc_s_label.
        ELSE.
          PERFORM top_style USING lv_r ls_cell-col CHANGING lv_style.
        ENDIF.
        PERFORM xml_cell USING ls_cell lv_style CHANGING lt_xml.
      ENDLOOP.
    ELSE.
*     table area: every column, so fills / borders cover empty cells
      LOOP AT gt_col INTO ls_col.
        READ TABLE gt_out INTO ls_cell WITH TABLE KEY row = lv_r col = ls_col-col.
        IF sy-subrc <> 0.
          CLEAR ls_cell.
          ls_cell-row = lv_r.
          ls_cell-col = ls_col-col.
        ENDIF.
        IF lv_r <= gc_r_head.
          lv_style = gc_s_head.
        ELSEIF lv_r = gv_totrow.
          lv_style = gc_s_total.
        ELSE.
          PERFORM body_style USING ls_col CHANGING lv_style.
        ENDIF.
        PERFORM xml_cell USING ls_cell lv_style CHANGING lt_xml.
      ENDLOOP.
    ENDIF.
    APPEND '</row>' TO lt_xml.
  ENDDO.
  APPEND '</sheetData>' TO lt_xml.

* sheet protection: SAP, formula, header and hidden cells are locked;
* filter and column / row resizing stay allowed
  CONCATENATE '<sheetProtection password="' gc_pwd_hash '" sheet="1" objects="1" scenarios="1"'
    ' formatColumns="0" formatRows="0" autoFilter="0"/>' INTO lv_part.
  APPEND lv_part TO lt_xml.

* merged cells
  lv_n = lines( gt_merge ). CONDENSE lv_n.
  CONCATENATE '<mergeCells count="' lv_n '">' INTO lv_part.
  APPEND lv_part TO lt_xml.
  LOOP AT gt_merge INTO lv_a.
    CONCATENATE '<mergeCell ref="' lv_a '"/>' INTO lv_part.
    APPEND lv_part TO lt_xml.
  ENDLOOP.
  APPEND '</mergeCells>' TO lt_xml.

* data validations
  APPEND '<dataValidations>' TO lt_xml.
  PERFORM has_list USING 'L_EQART' CHANGING lv_ok.
  IF lv_ok = abap_true.
    PERFORM dv_list USING gc_c_eqart 'L_EQART' 'Equipment Group' CHANGING lt_xml.
  ENDIF.
  PERFORM has_list USING 'L_CLASS' CHANGING lv_ok.
  IF lv_ok = abap_true.
    PERFORM dv_list USING gc_c_class 'L_CLASS' 'Equipment Class' CHANGING lt_xml.
  ENDIF.
  PERFORM has_list USING 'EQUI' CHANGING lv_ok.
  IF lv_ok = abap_true.
    PERFORM dv_equipment CHANGING lt_xml.
  ENDIF.
  PERFORM dv_list USING gc_c_avl   'L_AVL'   'Avl/Req/Sur'   CHANGING lt_xml.
  PERFORM dv_numbers CHANGING lt_xml.
  PERFORM dv_dates CHANGING lt_xml.
  APPEND '</dataValidations>' TO lt_xml.

  CONCATENATE '<pageMargins left="0.3" right="0.3" top="0.5" bottom="0.5" header="0.3" footer="0.3"/>'
    '<pageSetup paperSize="8" orientation="landscape" fitToHeight="0"/>'
    '<tableParts count="1"><tablePart r:id="rId1"/></tableParts>'
    '</worksheet>' INTO lv_part.
  APPEND lv_part TO lt_xml.

  CONCATENATE LINES OF lt_xml INTO cv.
ENDFORM.

* list dropdown on one column of the table body
FORM dv_list USING iv_col TYPE i iv_name TYPE any iv_title TYPE any
             CHANGING ct TYPE string_table.
  DATA: lv_a    TYPE string,
        lv_part TYPE string.
  PERFORM addr USING iv_col gc_r_data iv_col gv_lastrow CHANGING lv_a.
  CONCATENATE '<dataValidation type="list" allowBlank="1" showInputMessage="1" showErrorMessage="1"'
    ' errorTitle="' iv_title '" error="Select a value from the list"'
    ' sqref="' lv_a '"><formula1>' iv_name '</formula1></dataValidation>' INTO lv_part.
  APPEND lv_part TO ct.
ENDFORM.

*----------------------------------------------------------------------*
* Equipment code: dependent dropdown - equipment of the Equipment Class
* selected in column C of the same row (LISTS!F:G, sorted by class):
*   OFFSET(LISTS!$G$1, MATCH($C13,LISTS!$F:$F,0)-1, 0,
*          COUNTIF(LISTS!$F:$F,$C13), 1)
*----------------------------------------------------------------------*
FORM dv_equipment CHANGING ct TYPE string_table.
  DATA: lv_a    TYPE string,
        lv_c    TYPE string,
        lv_part TYPE string.
  PERFORM addr USING gc_c_equnr gc_r_data gc_c_equnr gv_lastrow CHANGING lv_a.
  PERFORM cell_ref USING gc_c_class gc_r_data CHANGING lv_c.
  CONCATENATE '$' lv_c INTO lv_c.                         " $C13
  CONCATENATE '<dataValidation type="list" allowBlank="1" showInputMessage="1" showErrorMessage="1"'
    ' errorTitle="Equipment code" error="Select the Equipment Class first, then an equipment of that class"'
    ' sqref="' lv_a '"><formula1>OFFSET(' gc_sheet_list '!$G$1,MATCH(' lv_c ',' gc_sheet_list
    '!$F:$F,0)-1,0,COUNTIF(' gc_sheet_list '!$F:$F,' lv_c '),1)</formula1></dataValidation>'
    INTO lv_part.
  APPEND lv_part TO ct.
ENDFORM.

* planned costs and Qty: numbers >= 0
FORM dv_numbers CHANGING ct TYPE string_table.
  DATA: lv_a    TYPE string,
        lv_b    TYPE string,
        lv_part TYPE string.
  PERFORM addr USING gc_c_pihc gc_r_data gc_c_pful gv_lastrow CHANGING lv_a.
  PERFORM addr USING gc_c_qty  gc_r_data gc_c_qty  gv_lastrow CHANGING lv_b.
  CONCATENATE '<dataValidation type="decimal" operator="greaterThanOrEqual" allowBlank="1"'
    ' showErrorMessage="1" errorTitle="Number" error="Enter a number (0 or more)"'
    ' sqref="' lv_a ` ` lv_b '"><formula1>0</formula1></dataValidation>' INTO lv_part.
  APPEND lv_part TO ct.
ENDFORM.

* plan / revised plan dates
FORM dv_dates CHANGING ct TYPE string_table.
  DATA: lv_a    TYPE string,
        lv_b    TYPE string,
        lv_part TYPE string.
  PERFORM addr USING gc_c_pfrm gc_r_data gc_c_pto gv_lastrow CHANGING lv_a.
  PERFORM addr USING gc_c_rfrm gc_r_data gc_c_rto gv_lastrow CHANGING lv_b.
  CONCATENATE '<dataValidation type="date" operator="greaterThan" allowBlank="1"'
    ' showErrorMessage="1" errorTitle="Date" error="Enter a date, e.g. 01-Oct-26"'
    ' sqref="' lv_a ` ` lv_b '"><formula1>1</formula1></dataValidation>' INTO lv_part.
  APPEND lv_part TO ct.
ENDFORM.

*----------------------------------------------------------------------*
* Excel Table over the resource lines (header row 12 .. totals row)
*----------------------------------------------------------------------*
FORM xml_table CHANGING cv TYPE string.
  DATA: lt_xml  TYPE string_table,
        ls_col  TYPE ty_col,
        lv_ref  TYPE string,
        lv_af   TYPE string,
        lv_id   TYPE string,
        lv_n    TYPE string,
        lv_nm   TYPE string,
        lv_f    TYPE string,
        lv_part TYPE string.

  PERFORM addr USING 1 gc_r_head gc_c_last gv_totrow  CHANGING lv_ref.
  PERFORM addr USING 1 gc_r_head gc_c_last gv_lastrow CHANGING lv_af.
  lv_n = lines( gt_col ). CONDENSE lv_n.
  CONCATENATE '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
    '<table xmlns="' gc_ns_main '" id="1" name="' gc_table '" displayName="' gc_table '"'
    ' ref="' lv_ref '" totalsRowCount="1">'
    '<autoFilter ref="' lv_af '"/>'
    '<tableColumns count="' lv_n '">' INTO lv_part.
  APPEND lv_part TO lt_xml.

  LOOP AT gt_col INTO ls_col.
    lv_id = sy-tabix. CONDENSE lv_id.
    PERFORM xml_escape USING ls_col-name CHANGING lv_nm.
    CASE ls_col-tot.
      WHEN 'L'.
        CONCATENATE '<tableColumn id="' lv_id '" name="' lv_nm '" totalsRowLabel="Total"' INTO lv_part.
      WHEN 'S'.
        CONCATENATE '<tableColumn id="' lv_id '" name="' lv_nm '" totalsRowFunction="sum"' INTO lv_part.
      WHEN OTHERS.
        CONCATENATE '<tableColumn id="' lv_id '" name="' lv_nm '"' INTO lv_part.
    ENDCASE.
    IF ls_col-calc IS INITIAL.
      CONCATENATE lv_part '/>' INTO lv_part.
    ELSE.
      PERFORM xml_escape USING ls_col-calc CHANGING lv_f.
      CONCATENATE lv_part '><calculatedColumnFormula>' lv_f '</calculatedColumnFormula></tableColumn>'
        INTO lv_part.
    ENDIF.
    APPEND lv_part TO lt_xml.
  ENDLOOP.

  CONCATENATE '</tableColumns>'
    '<tableStyleInfo name="TableStyleLight1" showFirstColumn="0" showLastColumn="0"'
    ' showRowStripes="0" showColumnStripes="0"/>'
    '</table>' INTO lv_part.
  APPEND lv_part TO lt_xml.
  CONCATENATE LINES OF lt_xml INTO cv.
ENDFORM.

*----------------------------------------------------------------------*
* plain sheet from a cell table (LISTS, CONTROL)
*----------------------------------------------------------------------*
FORM xml_simple_sheet USING it_cells TYPE ty_t_cell iv_width TYPE any
                      CHANGING cv TYPE string.
  DATA: lt_xml  TYPE string_table,
        ls_cell TYPE ty_cell,
        lv_old  TYPE i,
        lv_rs   TYPE string,
        lv_part TYPE string,
        lv_st   TYPE i.

  CONCATENATE '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
    '<worksheet xmlns="' gc_ns_main '" xmlns:r="' gc_ns_rel '">'
    '<cols><col min="1" max="10" width="' iv_width '" customWidth="1"/></cols>'
    '<sheetData>' INTO lv_part.
  APPEND lv_part TO lt_xml.

  LOOP AT it_cells INTO ls_cell.
    IF ls_cell-row <> lv_old.
      IF lv_old > 0.
        APPEND '</row>' TO lt_xml.
      ENDIF.
      lv_rs = ls_cell-row. CONDENSE lv_rs.
      CONCATENATE '<row r="' lv_rs '">' INTO lv_part.
      APPEND lv_part TO lt_xml.
      lv_old = ls_cell-row.
    ENDIF.
    lv_st = gc_s_none.
    PERFORM xml_cell USING ls_cell lv_st CHANGING lt_xml.
  ENDLOOP.
  IF lv_old > 0.
    APPEND '</row>' TO lt_xml.
  ENDIF.
  APPEND '</sheetData></worksheet>' TO lt_xml.
  CONCATENATE LINES OF lt_xml INTO cv.
ENDFORM.

*----------------------------------------------------------------------*
* Binary download - in WebGUI / Fiori this is a browser download
*----------------------------------------------------------------------*
FORM send_file USING iv_x TYPE xstring CHANGING cv_ok TYPE abap_bool.
  DATA: lt_bin  TYPE solix_tab,
        lv_len  TYPE i,
        lv_file TYPE string.

  CALL FUNCTION 'SCMS_XSTRING_TO_BINARY'
    EXPORTING
      buffer        = iv_x
    IMPORTING
      output_length = lv_len
    TABLES
      binary_tab    = lt_bin.

  lv_file = p_file.
  IF lv_file IS INITIAL.
    PERFORM default_name CHANGING lv_file.
  ENDIF.

  cl_gui_frontend_services=>gui_download(
    EXPORTING
      bin_filesize = lv_len
      filename     = lv_file
      filetype     = 'BIN'
    CHANGING
      data_tab     = lt_bin
    EXCEPTIONS
      OTHERS       = 1 ).
  IF sy-subrc <> 0.
    cv_ok = abap_false.
    MESSAGE 'File could not be saved - check the path / close the file if open' TYPE 'S' DISPLAY LIKE 'E'.
  ELSE.
    cv_ok = abap_true.
  ENDIF.
ENDFORM.

*======================================================================*
*  UPLOAD
*======================================================================*
FORM upload.
  DATA: lt_bin  TYPE solix_tab,
        lv_len  TYPE i,
        lv_file TYPE string,
        lv_x    TYPE xstring,
        lv_ok   TYPE abap_bool.

  PERFORM auth_check USING '02' space CHANGING lv_ok.
  IF lv_ok = abap_false.
    MESSAGE 'No authorisation to change the fleet schedule of this profit center' TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  lv_file = p_file.
  IF lv_file IS INITIAL.
    IF gv_webgui = abap_true.
      lv_file = 'Fleet_Resource_Schedule.xlsx'.   " browser opens the file picker
    ELSE.
      MESSAGE 'Enter the file to upload' TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.
  ENDIF.

  cl_gui_frontend_services=>gui_upload(
    EXPORTING
      filename   = lv_file
      filetype   = 'BIN'
    IMPORTING
      filelength = lv_len
    CHANGING
      data_tab   = lt_bin
    EXCEPTIONS
      OTHERS     = 1 ).
  IF sy-subrc <> 0 OR lv_len = 0.
    MESSAGE 'File could not be read' TYPE 'S' DISPLAY LIKE 'E'.
    RETURN.
  ENDIF.

  CALL FUNCTION 'SCMS_BINARY_TO_XSTRING'
    EXPORTING
      input_length = lv_len
    IMPORTING
      buffer       = lv_x
    TABLES
      binary_tab   = lt_bin
    EXCEPTIONS
      OTHERS       = 1.

  PERFORM read_xlsx USING lv_x CHANGING lv_ok.
  IF lv_ok = abap_false.
    PERFORM show_log.
    RETURN.
  ENDIF.

  PERFORM check_control.
  IF gt_log IS INITIAL.
    PERFORM check_headers.
  ENDIF.
  IF gt_log IS NOT INITIAL.
    PERFORM show_log.
    RETURN.
  ENDIF.

  PERFORM get_lists.
  IF gv_versn IS NOT INITIAL.
    PERFORM load_version USING gv_versn CHANGING gt_base.
  ENDIF.

  PERFORM parse_header.
  PERFORM parse_rows.
  PERFORM merge_with_base.
  PERFORM check_lines.

  READ TABLE gt_log TRANSPORTING NO FIELDS WITH KEY msgty = 'E'.
  IF sy-subrc = 0.
    PERFORM add_log USING 0 'E' 'Upload rejected - correct the errors and upload again. Nothing saved.'.
  ELSE.
    PERFORM save_version.
  ENDIF.
  PERFORM show_log.
ENDFORM.

*======================================================================*
*  XLSX READER - fills GT_IN (main sheet) and GT_CTL (CONTROL sheet)
*======================================================================*
FORM parse_xml USING iv_x TYPE xstring CHANGING co_doc TYPE REF TO if_ixml_document.
  DATA: lo_ixml   TYPE REF TO if_ixml,
        lo_sf     TYPE REF TO if_ixml_stream_factory,
        lo_is     TYPE REF TO if_ixml_istream,
        lo_parser TYPE REF TO if_ixml_parser.
  CLEAR co_doc.
  lo_ixml   = cl_ixml=>create( ).
  lo_sf     = lo_ixml->create_stream_factory( ).
  lo_is     = lo_sf->create_istream_xstring( iv_x ).
  co_doc    = lo_ixml->create_document( ).
  lo_parser = lo_ixml->create_parser( stream_factory = lo_sf
                                      istream        = lo_is
                                      document       = co_doc ).
  IF lo_parser->parse( ) <> 0.
    CLEAR co_doc.
  ENDIF.
ENDFORM.

* concatenated text of all <t> below an element (rich-text runs)
FORM node_text USING io_el TYPE REF TO if_ixml_element CHANGING cv TYPE string.
  DATA: lo_coll TYPE REF TO if_ixml_node_collection,
        lo_iter TYPE REF TO if_ixml_node_iterator,
        lo_node TYPE REF TO if_ixml_node,
        lv_t    TYPE string.
  CLEAR cv.
  lo_coll = io_el->get_elements_by_tag_name_ns( name = 't' uri = gc_ns_main ).
  lo_iter = lo_coll->create_iterator( ).
  lo_node = lo_iter->get_next( ).
  WHILE lo_node IS BOUND.
    lv_t = lo_node->get_value( ).
    CONCATENATE cv lv_t INTO cv RESPECTING BLANKS.
    lo_node = lo_iter->get_next( ).
  ENDWHILE.
ENDFORM.

FORM read_xlsx USING iv_x TYPE xstring CHANGING cv_ok TYPE abap_bool.
  DATA: lo_zip   TYPE REF TO cl_abap_zip,
        lo_doc   TYPE REF TO if_ixml_document,
        lo_coll  TYPE REF TO if_ixml_node_collection,
        lo_iter  TYPE REF TO if_ixml_node_iterator,
        lo_el    TYPE REF TO if_ixml_element,
        lv_part  TYPE xstring,
        lt_sst   TYPE string_table,
        lv_txt   TYPE string,
        lv_name  TYPE string,
        lv_rmain TYPE string,
        lv_rctl  TYPE string,
        lv_rid   TYPE string,
        lv_id    TYPE string,
        lv_tmain TYPE string,
        lv_tctl  TYPE string.

  cv_ok = abap_false.
  CLEAR: gt_in, gt_ctl.

  CREATE OBJECT lo_zip.
  lo_zip->load( EXPORTING zip = iv_x EXCEPTIONS OTHERS = 1 ).
  IF sy-subrc <> 0.
    PERFORM add_log USING 0 'E' 'File is not an .xlsx workbook (save as Excel Workbook *.xlsx)'.
    RETURN.
  ENDIF.

* --- workbook: r:id of the main and the CONTROL sheet
  lo_zip->get( EXPORTING name = 'xl/workbook.xml' IMPORTING content = lv_part
               EXCEPTIONS OTHERS = 1 ).
  IF sy-subrc = 0.
    PERFORM parse_xml USING lv_part CHANGING lo_doc.
  ENDIF.
  IF lo_doc IS NOT BOUND.
    PERFORM add_log USING 0 'E' 'Workbook part could not be read'.
    RETURN.
  ENDIF.
  lo_coll = lo_doc->get_elements_by_tag_name_ns( name = 'sheet' uri = gc_ns_main ).
  lo_iter = lo_coll->create_iterator( ).
  lo_el ?= lo_iter->get_next( ).
  WHILE lo_el IS BOUND.
    lv_name = lo_el->get_attribute( name = 'name' ).
    lv_rid  = lo_el->get_attribute_ns( name = 'id' uri = gc_ns_rel ).
    IF lv_name = gc_sheet_main OR lv_rmain IS INITIAL.
      lv_rmain = lv_rid.                         " first sheet as fallback
    ENDIF.
    IF lv_name = gc_sheet_ctrl.
      lv_rctl = lv_rid.
    ENDIF.
    lo_el ?= lo_iter->get_next( ).
  ENDWHILE.
  IF lv_rctl IS INITIAL.
    PERFORM add_log USING 0 'E' 'Not a Fleet & Resource Schedule file from ZFLEET (CONTROL sheet missing)'.
    RETURN.
  ENDIF.

* --- relationships -> worksheet parts
  CLEAR lo_doc.
  lo_zip->get( EXPORTING name = 'xl/_rels/workbook.xml.rels' IMPORTING content = lv_part
               EXCEPTIONS OTHERS = 1 ).
  IF sy-subrc = 0.
    PERFORM parse_xml USING lv_part CHANGING lo_doc.
  ENDIF.
  IF lo_doc IS BOUND.
    lo_coll = lo_doc->get_elements_by_tag_name_ns( name = 'Relationship' uri = gc_ns_pkg ).
    lo_iter = lo_coll->create_iterator( ).
    lo_el ?= lo_iter->get_next( ).
    WHILE lo_el IS BOUND.
      lv_id = lo_el->get_attribute( name = 'Id' ).
      IF lv_id = lv_rmain.
        lv_tmain = lo_el->get_attribute( name = 'Target' ).
      ENDIF.
      IF lv_id = lv_rctl.
        lv_tctl = lo_el->get_attribute( name = 'Target' ).
      ENDIF.
      lo_el ?= lo_iter->get_next( ).
    ENDWHILE.
  ENDIF.
  IF lv_tmain IS INITIAL OR lv_tctl IS INITIAL.
    PERFORM add_log USING 0 'E' 'Worksheet not found in file'.
    RETURN.
  ENDIF.

* --- shared strings (optional part - Excel writes it on save)
  CLEAR lo_doc.
  lo_zip->get( EXPORTING name = 'xl/sharedStrings.xml' IMPORTING content = lv_part
               EXCEPTIONS OTHERS = 1 ).
  IF sy-subrc = 0.
    PERFORM parse_xml USING lv_part CHANGING lo_doc.
  ENDIF.
  IF lo_doc IS BOUND.
    lo_coll = lo_doc->get_elements_by_tag_name_ns( name = 'si' uri = gc_ns_main ).
    lo_iter = lo_coll->create_iterator( ).
    lo_el ?= lo_iter->get_next( ).
    WHILE lo_el IS BOUND.
      PERFORM node_text USING lo_el CHANGING lv_txt.
      APPEND lv_txt TO lt_sst.
      lo_el ?= lo_iter->get_next( ).
    ENDWHILE.
  ENDIF.

  PERFORM read_sheet USING lo_zip lv_tmain lt_sst CHANGING gt_in cv_ok.
  IF cv_ok = abap_true.
    PERFORM read_sheet USING lo_zip lv_tctl lt_sst CHANGING gt_ctl cv_ok.
  ENDIF.
ENDFORM.

FORM read_sheet USING    io_zip    TYPE REF TO cl_abap_zip
                         iv_target TYPE string
                         it_sst    TYPE string_table
                CHANGING ct        TYPE ty_t_cell
                         cv_ok     TYPE abap_bool.
  DATA: lo_doc  TYPE REF TO if_ixml_document,
        lo_coll TYPE REF TO if_ixml_node_collection,
        lo_iter TYPE REF TO if_ixml_node_iterator,
        lo_el   TYPE REF TO if_ixml_element,
        lo_v    TYPE REF TO if_ixml_element,
        lv_part TYPE xstring,
        lv_path TYPE string,
        lv_ref  TYPE string,
        lv_t    TYPE string,
        lv_v    TYPE string,
        lv_idx  TYPE i,
        ls_cell TYPE ty_cell.

  cv_ok = abap_false.
  CLEAR ct.
  lv_path = iv_target.
  IF lv_path(1) = '/'.
    SHIFT lv_path LEFT BY 1 PLACES.              " /xl/worksheets/...
  ELSE.
    CONCATENATE 'xl/' lv_path INTO lv_path.
  ENDIF.

  io_zip->get( EXPORTING name = lv_path IMPORTING content = lv_part
               EXCEPTIONS OTHERS = 1 ).
  IF sy-subrc = 0.
    PERFORM parse_xml USING lv_part CHANGING lo_doc.
  ENDIF.
  IF lo_doc IS NOT BOUND.
    PERFORM add_log USING 0 'E' 'Worksheet could not be read'.
    RETURN.
  ENDIF.

  lo_coll = lo_doc->get_elements_by_tag_name_ns( name = 'c' uri = gc_ns_main ).
  lo_iter = lo_coll->create_iterator( ).
  lo_el ?= lo_iter->get_next( ).
  WHILE lo_el IS BOUND.
    lv_ref = lo_el->get_attribute( name = 'r' ).
    lv_t   = lo_el->get_attribute( name = 't' ).
    CLEAR lv_v.
    IF lv_t = 'inlineStr'.
      PERFORM node_text USING lo_el CHANGING lv_v.
    ELSE.
      lo_v = lo_el->find_from_name_ns( name = 'v' uri = gc_ns_main ).
      IF lo_v IS BOUND.
        lv_v = lo_v->get_value( ).
        IF lv_t = 's'.                              " shared string index
          lv_idx = lv_v + 1.
          CLEAR lv_v.
          READ TABLE it_sst INTO lv_v INDEX lv_idx.
        ELSEIF lv_t = 'e'.                          " #N/A, #VALUE! ...
          CLEAR lv_v.
        ENDIF.
      ENDIF.
    ENDIF.
    CONDENSE lv_v.
    IF lv_v IS NOT INITIAL AND lv_ref IS NOT INITIAL.
      CLEAR ls_cell.
      PERFORM parse_ref USING lv_ref CHANGING ls_cell-col ls_cell-row.
      ls_cell-value = lv_v.
      INSERT ls_cell INTO TABLE ct.
    ENDIF.
    lo_el ?= lo_iter->get_next( ).
  ENDWHILE.
  cv_ok = abap_true.
ENDFORM.

*----------------------------------------------------------------------*
FORM get_in USING iv_row TYPE i iv_col TYPE i CHANGING cv TYPE string.
  DATA ls_cell TYPE ty_cell.
  CLEAR cv.
  READ TABLE gt_in INTO ls_cell WITH TABLE KEY row = iv_row col = iv_col.
  IF sy-subrc = 0.
    cv = ls_cell-value.
  ENDIF.
ENDFORM.

FORM get_ctl USING iv_col TYPE i CHANGING cv TYPE string.
  DATA ls_cell TYPE ty_cell.
  CLEAR cv.
  READ TABLE gt_ctl INTO ls_cell WITH TABLE KEY row = 1 col = iv_col.
  IF sy-subrc = 0.
    cv = ls_cell-value.
  ENDIF.
ENDFORM.

*----------------------------------------------------------------------*
* File belongs to this project, is current, and may be uploaded
*----------------------------------------------------------------------*
FORM check_control.
  DATA: lv_val TYPE string,
        lv_txt TYPE string,
        lv_ver TYPE zps_t_fr_hdr-versn.

  PERFORM get_ctl USING 1 CHANGING lv_val.
  IF lv_val <> gc_marker.
    PERFORM add_log USING 0 'E' 'Not a Fleet & Resource Schedule file from ZFLEET'.
    RETURN.
  ENDIF.

  PERFORM get_ctl USING 2 CHANGING lv_val.
  IF lv_val <> gv_ext_pspid.
    CONCATENATE 'File belongs to project' lv_val ', not' gv_ext_pspid
      INTO lv_txt SEPARATED BY space.
    PERFORM add_log USING 0 'E' lv_txt.
    RETURN.
  ENDIF.

  PERFORM get_ctl USING 8 CHANGING lv_val.
  gv_mode = lv_val.
  IF gv_mode = gc_mode_display.
    PERFORM add_log USING 0 'E' 'File was downloaded for display only (older version / no change authorisation)'.
    RETURN.
  ENDIF.

  PERFORM get_ctl USING 3 CHANGING lv_val.
  IF lv_val CN '0123456789' OR lv_val IS INITIAL.
    PERFORM add_log USING 0 'E' 'Version key on CONTROL sheet is damaged - download again'.
    RETURN.
  ENDIF.
  lv_ver = lv_val.
  SELECT MAX( versn ) FROM zps_t_fr_hdr INTO gv_latest
    WHERE pspid = gs_proj-pspid.
  IF lv_ver <> gv_latest.
    IF gv_latest IS INITIAL.
      CONCATENATE 'File is based on version' lv_ver 'but the project has no saved version'
        INTO lv_txt SEPARATED BY space.
    ELSE.
      CONCATENATE 'Version' gv_latest 'was saved after this file was downloaded (base version'
                  lv_ver ') - download again and re-apply your changes'
        INTO lv_txt SEPARATED BY space.
    ENDIF.
    PERFORM add_log USING 0 'E' lv_txt.
    RETURN.
  ENDIF.
  gv_versn = lv_ver.
  IF gv_versn IS NOT INITIAL.
    SELECT SINGLE * FROM zps_t_fr_hdr INTO gs_hdr
      WHERE pspid = gs_proj-pspid AND versn = gv_versn.
  ENDIF.

  PERFORM get_ctl USING 4 CHANGING lv_val.
  gv_spmon = lv_val.
  PERFORM get_ctl USING 5 CHANGING lv_val.
  gv_perfr = lv_val.
  PERFORM get_ctl USING 6 CHANGING lv_val.
  gv_perto = lv_val.
  PERFORM get_ctl USING 7 CHANGING lv_val.
  gv_ownhr = lv_val.
  IF gv_spmon IS INITIAL OR gv_spmon+4(2) < '01' OR gv_spmon+4(2) > '12'.
    PERFORM add_log USING 0 'E' 'Reporting month on CONTROL sheet is damaged - download again'.
    RETURN.
  ENDIF.
  PERFORM set_windows.
ENDFORM.

*----------------------------------------------------------------------*
* Columns must not be moved / inserted / deleted
*----------------------------------------------------------------------*
FORM check_headers.
  DATA: ls_col TYPE ty_col,
        lv_v   TYPE string,
        lv_e   TYPE string,
        lv_c   TYPE string,
        lv_txt TYPE string.
  LOOP AT gt_col INTO ls_col.
    PERFORM get_in USING gc_r_head ls_col-col CHANGING lv_v.
    lv_e = ls_col-name.
    CONDENSE lv_e.
    IF lv_v <> lv_e.
      PERFORM col_letter USING ls_col-col CHANGING lv_c.
      CONCATENATE 'Column' lv_c 'should be "' lv_e '" but is "' lv_v
                  '" - columns must not be inserted, deleted or renamed'
        INTO lv_txt SEPARATED BY space.
      PERFORM add_log USING gc_r_head 'E' lv_txt.
      RETURN.
    ENDIF.
  ENDLOOP.
ENDFORM.

*----------------------------------------------------------------------*
* Header entries: expected completion date, sanctioned cost
*----------------------------------------------------------------------*
FORM parse_header.
  DATA: lv_v   TYPE string,
        lv_ok  TYPE abap_bool,
        lv_txt TYPE string.

  PERFORM get_in USING gc_r_cli gc_c_hval CHANGING lv_v.
  CLEAR gv_expcd.
  IF lv_v IS NOT INITIAL.
    PERFORM str2date USING lv_v CHANGING gv_expcd lv_ok.
    IF lv_ok = abap_false.
      CONCATENATE 'Invalid Expected Completion Date' lv_v INTO lv_txt SEPARATED BY space.
      PERFORM add_log USING gc_r_cli 'E' lv_txt.
    ELSEIF gs_proj-plfaz IS NOT INITIAL AND gv_expcd < gs_proj-plfaz.
      PERFORM add_log USING gc_r_cli 'E' 'Expected Completion Date is before the contractual start date'.
    ENDIF.
  ENDIF.

  PERFORM get_in USING gc_r_sanc gc_c_hval CHANGING lv_v.
  CLEAR gv_sncost.
  IF lv_v IS NOT INITIAL.
    PERFORM str2amt USING lv_v CHANGING gv_sncost lv_ok.
    IF lv_ok = abap_false OR gv_sncost < 0.
      CONCATENATE 'Invalid Sanctioned / Contracted Cost' lv_v INTO lv_txt SEPARATED BY space.
      PERFORM add_log USING gc_r_sanc 'E' lv_txt.
    ENDIF.
  ENDIF.
ENDFORM.

*----------------------------------------------------------------------*
* Resource lines from row 13 down to the totals row
*----------------------------------------------------------------------*
FORM parse_rows.
  DATA: ls_cell TYPE ty_cell,
        ls_ln   TYPE ty_line,
        ls_base TYPE ty_line,
        lv_maxr TYPE i,
        lv_r    TYPE i,
        lv_seq  TYPE i,
        lv_v    TYPE string,
        lv_ok   TYPE abap_bool,
        lv_txt  TYPE string,
        lv_any  TYPE abap_bool,
        lv_lin  TYPE zps_t_fr_itm-linid,
        lt_used TYPE SORTED TABLE OF zps_t_fr_itm-linid WITH UNIQUE KEY table_line.

  CLEAR gt_line.
  LOOP AT gt_in INTO ls_cell.
    IF ls_cell-row > lv_maxr. lv_maxr = ls_cell-row. ENDIF.
  ENDLOOP.

  lv_r = gc_r_data - 1.
  WHILE lv_r < lv_maxr.
    lv_r = lv_r + 1.

*   totals row ends the table
    PERFORM get_in USING lv_r gc_c_sno CHANGING lv_v.
    TRANSLATE lv_v TO UPPER CASE.
    IF lv_v = 'TOTAL'.
      EXIT.
    ENDIF.
*   totals row switched off in Excel - stop at the signature line
    PERFORM get_in USING lv_r gc_c_eqart CHANGING lv_v.
    IF lv_v CP '(Planning Incharge)*'.
      EXIT.
    ENDIF.

*   any user-entered value in the row?
    CLEAR lv_any.
    LOOP AT gt_in INTO ls_cell WHERE row = lv_r.
      IF ls_cell-col = gc_c_eqart OR ls_cell-col = gc_c_class OR ls_cell-col = gc_c_equnr OR
         ls_cell-col = gc_c_avl  OR
         ls_cell-col = gc_c_ownc OR ls_cell-col = gc_c_qty   OR
         ls_cell-col = gc_c_pihc OR ls_cell-col = gc_c_popr  OR ls_cell-col = gc_c_pful  OR
         ls_cell-col = gc_c_pfrm OR ls_cell-col = gc_c_pto   OR ls_cell-col = gc_c_rfrm  OR
         ls_cell-col = gc_c_rto  OR ls_cell-col = gc_c_rem.
        lv_any = abap_true.
        EXIT.
      ENDIF.
    ENDLOOP.
    IF lv_any = abap_false.
      CONTINUE.                                     " empty row
    ENDIF.

    CLEAR ls_ln.
    ls_ln-row = lv_r.
    lv_seq = lv_seq + 1.
    ls_ln-sortkey = lv_seq.

*   line identity (hidden column AL) - kept only if known and unused
    PERFORM get_in USING lv_r gc_c_lin CHANGING lv_v.
    IF lv_v IS NOT INITIAL AND lv_v CO '0123456789' AND strlen( lv_v ) <= 6.
      lv_lin = lv_v.
      READ TABLE gt_base INTO ls_base WITH KEY linid = lv_lin.
      IF sy-subrc = 0.
        INSERT lv_lin INTO TABLE lt_used.
        IF sy-subrc = 0.
          ls_ln-linid = lv_lin.
        ELSE.
          PERFORM add_log USING lv_r 'I' 'Copied row - saved as a new resource line'.
        ENDIF.
      ENDIF.
    ENDIF.

*   Equipment Group (object type) - overwritten from the equipment master
    PERFORM get_in USING lv_r gc_c_eqart CHANGING lv_v.
    PERFORM eqart_code USING lv_v CHANGING ls_ln-eqart lv_ok.
    IF lv_ok = abap_false.
      CONCATENATE 'Equipment Group' lv_v 'not found - select from the list' INTO lv_txt SEPARATED BY space.
      PERFORM add_log USING lv_r 'E' lv_txt.
    ENDIF.
    PERFORM eqart_text USING ls_ln-eqart CHANGING ls_ln-eqtxt.

*   Own / Hired: from SAP (equipment category) - sheet value ignored

*   Equipment Class (required - it describes the line)
    PERFORM get_in USING lv_r gc_c_class CHANGING lv_v.
    PERFORM class_code USING lv_v CHANGING ls_ln-class lv_ok.
    IF lv_ok = abap_false.
      CONCATENATE 'Equipment Class' lv_v 'not found - select from the list' INTO lv_txt SEPARATED BY space.
      PERFORM add_log USING lv_r 'E' lv_txt.
    ELSEIF ls_ln-class IS INITIAL.
      PERFORM add_log USING lv_r 'E' 'Equipment Class is required'.
    ENDIF.
    PERFORM class_text USING ls_ln-class CHANGING ls_ln-clstxt.

*   Equipment
    PERFORM get_in USING lv_r gc_c_equnr CHANGING lv_v.
    IF lv_v IS NOT INITIAL.
      CONDENSE lv_v NO-GAPS.
      TRANSLATE lv_v TO UPPER CASE.
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = lv_v
        IMPORTING
          output = ls_ln-equnr.
    ENDIF.

*   Avl / Req / Sur
    PERFORM get_in USING lv_r gc_c_avl CHANGING lv_v.
    PERFORM avl_code USING lv_v CHANGING ls_ln-avlrq lv_ok.
    IF lv_ok = abap_false.
      CONCATENATE 'Avl/Req/Sur' lv_v 'is not valid' INTO lv_txt SEPARATED BY space.
      PERFORM add_log USING lv_r 'E' lv_txt.
    ELSEIF ls_ln-avlrq IS INITIAL.
      PERFORM add_log USING lv_r 'E' 'Avl/Req/Sur is required'.
    ENDIF.

*   Asset code, sub-asset, description: from the equipment (FETCH_SAP)
*   Qty: entered; blank = 1
    PERFORM get_in USING lv_r gc_c_qty CHANGING lv_v.
    IF lv_v IS INITIAL.
      ls_ln-qty = 1.
    ELSE.
      PERFORM str2amt USING lv_v CHANGING ls_ln-qty lv_ok.
      IF lv_ok = abap_false OR ls_ln-qty <= 0.
        CONCATENATE 'Invalid Qty' lv_v '(enter a number greater than 0)' INTO lv_txt SEPARATED BY space.
        PERFORM add_log USING lv_r 'E' lv_txt.
      ENDIF.
    ENDIF.

*   Owner code
    PERFORM get_in USING lv_r gc_c_ownc CHANGING lv_v.
    ls_ln-owncd = lv_v.

*   Planned cost per month
    PERFORM read_amt USING lv_r gc_c_pihc 'Planned IHC/Hire' CHANGING ls_ln-pl_ihc.
    PERFORM read_amt USING lv_r gc_c_popr 'Planned Operator' CHANGING ls_ln-pl_opr.
    PERFORM read_amt USING lv_r gc_c_pful 'Planned Fuel'     CHANGING ls_ln-pl_fuel.

*   Plan / revised plan
    PERFORM read_date USING lv_r gc_c_pfrm 'Plan From'      CHANGING ls_ln-plfrm.
    PERFORM read_date USING lv_r gc_c_pto  'Plan To'        CHANGING ls_ln-plto.
    PERFORM read_date USING lv_r gc_c_rfrm 'Rev. Plan From' CHANGING ls_ln-rpfrm.
    PERFORM read_date USING lv_r gc_c_rto  'Rev. Plan To'   CHANGING ls_ln-rpto.
    IF ls_ln-plfrm IS NOT INITIAL AND ls_ln-plto IS NOT INITIAL AND ls_ln-plfrm > ls_ln-plto.
      PERFORM add_log USING lv_r 'E' 'Plan From is after Plan To'.
    ENDIF.
    IF ls_ln-rpfrm IS NOT INITIAL AND ls_ln-rpto IS NOT INITIAL AND ls_ln-rpfrm > ls_ln-rpto.
      PERFORM add_log USING lv_r 'E' 'Rev. Plan From is after Rev. Plan To'.
    ENDIF.
    IF ( ls_ln-plfrm IS INITIAL AND ls_ln-plto IS NOT INITIAL ) OR
       ( ls_ln-plfrm IS NOT INITIAL AND ls_ln-plto IS INITIAL ).
      PERFORM add_log USING lv_r 'W' 'Plan From / To incomplete - machine months not calculated'.
    ENDIF.
    IF ( ls_ln-plfrm IS NOT INITIAL AND gs_proj-plfaz IS NOT INITIAL AND ls_ln-plfrm < gs_proj-plfaz ) OR
       ( ls_ln-plto  IS NOT INITIAL AND gv_expcd IS NOT INITIAL AND ls_ln-plto > gv_expcd ).
      PERFORM add_log USING lv_r 'W' 'Plan dates are outside the contractual start / expected completion dates'.
    ENDIF.

*   Remarks
    PERFORM get_in USING lv_r gc_c_rem CHANGING lv_v.
    ls_ln-remark = lv_v.

*   SAP values (master data, actuals) for the reporting month
    PERFORM fetch_sap USING lv_r abap_true CHANGING ls_ln.
    APPEND ls_ln TO gt_line.
  ENDWHILE.
ENDFORM.

FORM read_amt USING iv_r TYPE i iv_c TYPE i iv_name TYPE any CHANGING cv TYPE any.
  DATA: lv_v   TYPE string,
        lv_ok  TYPE abap_bool,
        lv_a   TYPE zps_t_fr_hdr-sncost,
        lv_txt TYPE string.
  CLEAR cv.
  PERFORM get_in USING iv_r iv_c CHANGING lv_v.
  IF lv_v IS INITIAL.
    RETURN.
  ENDIF.
  PERFORM str2amt USING lv_v CHANGING lv_a lv_ok.
  IF lv_ok = abap_false OR lv_a < 0.
    CONCATENATE 'Invalid' iv_name lv_v INTO lv_txt SEPARATED BY space.
    PERFORM add_log USING iv_r 'E' lv_txt.
    RETURN.
  ENDIF.
  cv = lv_a.
ENDFORM.

FORM read_date USING iv_r TYPE i iv_c TYPE i iv_name TYPE any CHANGING cv TYPE d.
  DATA: lv_v   TYPE string,
        lv_ok  TYPE abap_bool,
        lv_txt TYPE string.
  CLEAR cv.
  PERFORM get_in USING iv_r iv_c CHANGING lv_v.
  IF lv_v IS INITIAL.
    RETURN.
  ENDIF.
  PERFORM str2date USING lv_v CHANGING cv lv_ok.
  IF lv_ok = abap_false.
    CONCATENATE 'Invalid' iv_name lv_v '(use DD-MMM-YY or DD.MM.YYYY)' INTO lv_txt SEPARATED BY space.
    PERFORM add_log USING iv_r 'E' lv_txt.
  ENDIF.
ENDFORM.

*----------------------------------------------------------------------*
* Line IDs, order, lines outside a filtered download, audit fields
*----------------------------------------------------------------------*
FORM merge_with_base.
  DATA: ls_ln   TYPE ty_line,
        ls_base TYPE ty_line,
        lv_in   TYPE abap_bool,
        lv_max  TYPE zps_t_fr_itm-linid,
        lv_key  TYPE i,
        lv_seq  TYPE i,
        lv_txt  TYPE string,
        lv_filt TYPE abap_bool,
        lv_ts   TYPE abap_bool.

  IF gv_ownhr IS NOT INITIAL OR gv_perfr IS NOT INITIAL.
    lv_filt = abap_true.
  ENDIF.

* highest line ID used so far in any version of the project
  SELECT MAX( linid ) FROM zps_t_fr_itm INTO lv_max
    WHERE pspid = gs_proj-pspid.

* lines in the file: new ID, audit fields
  lv_key = 0.
  LOOP AT gt_line INTO ls_ln.
    IF ls_ln-linid IS INITIAL.
      lv_max = lv_max + 1.
      ls_ln-linid = lv_max.
      ls_ln-ernam = sy-uname. ls_ln-erdat = sy-datum. ls_ln-erzet = sy-uzeit.
      ls_ln-aenam = sy-uname. ls_ln-aedat = sy-datum. ls_ln-aezet = sy-uzeit.
      PERFORM auth_line USING ls_ln.
      lv_key = lv_key + 1.
    ELSE.
      READ TABLE gt_base INTO ls_base WITH KEY linid = ls_ln-linid.
*     cost codes are not in the sheet any more - keep the saved values
      ls_ln-cstcd1 = ls_base-cstcd1.
      ls_ln-cstcd2 = ls_base-cstcd2.
      ls_ln-ernam = ls_base-ernam. ls_ln-erdat = ls_base-erdat. ls_ln-erzet = ls_base-erzet.
      PERFORM line_changed USING ls_ln ls_base CHANGING lv_ts.
      IF lv_ts = abap_true.
        ls_ln-aenam = sy-uname. ls_ln-aedat = sy-datum. ls_ln-aezet = sy-uzeit.
        PERFORM auth_line USING ls_ln.
      ELSE.
        ls_ln-aenam = ls_base-aenam. ls_ln-aedat = ls_base-aedat. ls_ln-aezet = ls_base-aezet.
      ENDIF.
      lv_key = ls_base-seqnr * 1000.
    ENDIF.
*   order: unfiltered file = file order; filtered = anchored on base order
    IF lv_filt = abap_true.
      ls_ln-sortkey = lv_key.
      lv_key = lv_key + 1.
    ENDIF.
    MODIFY gt_line FROM ls_ln.
  ENDLOOP.

* base lines missing from the file
  LOOP AT gt_base INTO ls_base.
    READ TABLE gt_line TRANSPORTING NO FIELDS WITH KEY linid = ls_base-linid.
    IF sy-subrc = 0.
      CONTINUE.
    ENDIF.
    PERFORM in_scope USING ls_base gv_ownhr gv_perfr gv_perto CHANGING lv_in.
    IF lv_in = abap_true.
      CONCATENATE 'Line' ls_base-asstxt '(ID' ls_base-linid ') was deleted in the file - removed from the schedule'
        INTO lv_txt SEPARATED BY space.
      PERFORM add_log USING 0 'W' lv_txt.
      PERFORM auth_line USING ls_base.
    ELSE.
*     outside the downloaded filter - carried forward with fresh SAP values
      ls_ln = ls_base.
      CLEAR ls_ln-row.
      PERFORM fetch_sap USING 0 abap_false CHANGING ls_ln.
      ls_ln-sortkey = ls_base-seqnr * 1000.
      APPEND ls_ln TO gt_line.
    ENDIF.
  ENDLOOP.

  SORT gt_line BY sortkey row.
  LOOP AT gt_line INTO ls_ln.
    lv_seq = lv_seq + 1.
    ls_ln-seqnr = lv_seq.
    MODIFY gt_line FROM ls_ln.
  ENDLOOP.

  IF gt_line IS INITIAL.
    PERFORM add_log USING 0 'E' 'No resource lines found in the file'.
  ENDIF.
ENDFORM.

* user-maintained fields changed compared with the base version?
FORM line_changed USING is_new TYPE ty_line is_old TYPE ty_line CHANGING cv TYPE abap_bool.
  cv = abap_false.
  IF is_new-eqart  <> is_old-eqart  OR is_new-class  <> is_old-class  OR
     is_new-equnr  <> is_old-equnr  OR is_new-avlrq  <> is_old-avlrq  OR
     is_new-cstcd1 <> is_old-cstcd1 OR is_new-cstcd2 <> is_old-cstcd2 OR

     is_new-owncd  <> is_old-owncd  OR is_new-plfrm  <> is_old-plfrm  OR
     is_new-qty    <> is_old-qty    OR
     is_new-plto   <> is_old-plto   OR is_new-rpfrm  <> is_old-rpfrm  OR
     is_new-rpto   <> is_old-rpto   OR is_new-remark <> is_old-remark OR
     is_new-pl_ihc <> is_old-pl_ihc OR is_new-pl_opr <> is_old-pl_opr OR
     is_new-pl_fuel <> is_old-pl_fuel.
    cv = abap_true.
  ENDIF.
ENDFORM.

* cost-code authorisation for a new / changed / deleted line
FORM auth_line USING is TYPE ty_line.
  DATA: lv_ok  TYPE abap_bool,
        lv_txt TYPE string.
  IF is-cstcd1 IS INITIAL.
    RETURN.
  ENDIF.
  PERFORM auth_check USING '02' is-cstcd1 CHANGING lv_ok.
  IF lv_ok = abap_false.
    CONCATENATE 'No authorisation to change lines of Cost Code-1' is-cstcd1
      INTO lv_txt SEPARATED BY space.
    PERFORM add_log USING is-row 'E' lv_txt.
  ENDIF.
ENDFORM.

*----------------------------------------------------------------------*
* Cross-line checks
*----------------------------------------------------------------------*
FORM check_lines.
  DATA: ls_a   TYPE ty_line,
        ls_b   TYPE ty_line,
        lv_ix  TYPE i,
        lv_af  TYPE d,
        lv_at  TYPE d,
        lv_bf  TYPE d,
        lv_bt  TYPE d,
        lv_pl  TYPE zps_t_fr_hdr-plntot,
        lv_ac  TYPE zps_t_fr_hdr-acttot,
        lv_s1  TYPE string,
        lv_s2  TYPE string,
        lv_ext TYPE string,
        lv_txt TYPE string.

* same equipment on two lines with overlapping deployment windows
  LOOP AT gt_line INTO ls_a WHERE equnr IS NOT INITIAL.
    lv_ix = sy-tabix + 1.
    PERFORM line_window USING ls_a CHANGING lv_af lv_at.
    LOOP AT gt_line INTO ls_b FROM lv_ix WHERE equnr = ls_a-equnr.
      PERFORM line_window USING ls_b CHANGING lv_bf lv_bt.
      IF lv_af <= lv_bt AND lv_bf <= lv_at.
        PERFORM alpha_out USING ls_a-equnr CHANGING lv_ext.
        CONCATENATE 'Equipment' lv_ext 'is on more than one line with overlapping dates'
          INTO lv_txt SEPARATED BY space.
        PERFORM add_log USING ls_b-row 'W' lv_txt.
      ENDIF.
    ENDLOOP.
  ENDLOOP.

* totals vs sanctioned / contracted cost
  LOOP AT gt_line INTO ls_a.
    lv_pl = lv_pl + ls_a-plncst.
    lv_ac = lv_ac + ls_a-actcst.
  ENDLOOP.
  IF gv_sncost IS NOT INITIAL.
    IF lv_pl > gv_sncost.
      PERFORM num2str USING lv_pl CHANGING lv_s1.
      PERFORM num2str USING gv_sncost CHANGING lv_s2.
      CONCATENATE 'Total planned cost' lv_s1 'exceeds the sanctioned / contracted cost' lv_s2
        INTO lv_txt SEPARATED BY space.
      PERFORM add_log USING gc_r_sanc 'E' lv_txt.
    ENDIF.
    IF lv_ac > gv_sncost.
      PERFORM num2str USING lv_ac CHANGING lv_s1.
      PERFORM num2str USING gv_sncost CHANGING lv_s2.
      CONCATENATE 'Total actual cost' lv_s1 'exceeds the sanctioned / contracted cost' lv_s2
        INTO lv_txt SEPARATED BY space.
      PERFORM add_log USING gc_r_sanc 'W' lv_txt.
    ENDIF.
  ELSE.
    PERFORM add_log USING gc_r_sanc 'W' 'Sanctioned / Contracted Cost is blank - cost ceiling not checked'.
  ENDIF.
ENDFORM.

FORM line_window USING is TYPE ty_line CHANGING cv_from TYPE d cv_to TYPE d.
  IF is-rpfrm IS NOT INITIAL OR is-rpto IS NOT INITIAL.
    cv_from = is-rpfrm. cv_to = is-rpto.
  ELSE.
    cv_from = is-plfrm. cv_to = is-plto.
  ENDIF.
  IF cv_from IS INITIAL. cv_from = '19000101'. ENDIF.
  IF cv_to   IS INITIAL. cv_to   = gc_open_date. ENDIF.
ENDFORM.

*----------------------------------------------------------------------*
* .xlsx stores numbers with '.' (e.g. 0.10000000000000001, 1E-2)
*----------------------------------------------------------------------*
FORM str2amt USING iv TYPE string CHANGING cv TYPE any cv_ok TYPE abap_bool.
  DATA: lv   TYPE string,
        lv_f TYPE f.
  cv_ok = abap_false.
  CLEAR cv.
  lv = iv.
  REPLACE ALL OCCURRENCES OF ',' IN lv WITH ''.
  CONDENSE lv NO-GAPS.
  IF lv = '-'.
    cv_ok = abap_true.
    RETURN.
  ENDIF.
  TRY.
      lv_f  = lv.
      cv    = lv_f.
      cv_ok = abap_true.
    CATCH cx_sy_conversion_no_number cx_sy_conversion_overflow.
      cv_ok = abap_false.
  ENDTRY.
ENDFORM.

*----------------------------------------------------------------------*
* Excel serial number (normal case in .xlsx) or text
* DD.MM.YYYY / DD/MM/YYYY / DD-MM-YYYY / YYYY-MM-DD / DD-MMM-YY
*----------------------------------------------------------------------*
FORM str2date USING iv TYPE string CHANGING cv_d TYPE d cv_ok TYPE abap_bool.
  DATA: lv     TYPE string,
        lt_p   TYPE STANDARD TABLE OF string,
        lv_p1  TYPE string,
        lv_p2  TYPE string,
        lv_p3  TYPE string,
        lv_dd  TYPE n LENGTH 2,
        lv_mm  TYPE n LENGTH 2,
        lv_yy  TYPE n LENGTH 4,
        lv_dot TYPE i,
        lv_ser TYPE i,
        lv_off TYPE i,
        lv_f   TYPE f,
        lv_mon TYPE c LENGTH 36 VALUE 'JANFEBMARAPRMAYJUNJULAUGSEPOCTNOVDEC'.

  cv_ok = abap_false.
  CLEAR cv_d.
  lv = iv.
  CONDENSE lv NO-GAPS.

  FIND ALL OCCURRENCES OF '.' IN lv MATCH COUNT lv_dot.
  IF lv CO '0123456789.' AND lv_dot <= 1 AND strlen( lv ) < 8.
*   serial number (fraction = time of day, ignored)
    TRY.
        lv_f   = lv.
        lv_ser = trunc( lv_f ).
      CATCH cx_sy_conversion_no_number cx_sy_conversion_overflow.
        RETURN.
    ENDTRY.
    IF lv_ser <= 0 OR lv_ser >= 100000.
      RETURN.
    ENDIF.
    cv_d = '18991230'.
    cv_d = cv_d + lv_ser.
  ELSE.
    TRANSLATE lv USING '/.-.'.
    TRANSLATE lv TO UPPER CASE.
    SPLIT lv AT '.' INTO TABLE lt_p.
    IF lines( lt_p ) <> 3.
      RETURN.
    ENDIF.
    READ TABLE lt_p INTO lv_p1 INDEX 1.
    READ TABLE lt_p INTO lv_p2 INDEX 2.
    READ TABLE lt_p INTO lv_p3 INDEX 3.
*   month name (01-OCT-26)
    IF strlen( lv_p2 ) = 3 AND lv_p2 CN '0123456789'.
      FIND lv_p2 IN lv_mon MATCH OFFSET lv_off.
      IF sy-subrc <> 0 OR lv_off MOD 3 <> 0.
        RETURN.
      ENDIF.
      lv_p2 = lv_off DIV 3 + 1.
      CONDENSE lv_p2.
    ENDIF.
    IF lv_p1 CN '0123456789' OR lv_p2 CN '0123456789' OR lv_p3 CN '0123456789'.
      RETURN.
    ENDIF.
    IF strlen( lv_p1 ) = 4.                     " YYYY.MM.DD
      lv_yy = lv_p1. lv_mm = lv_p2. lv_dd = lv_p3.
    ELSE.                                       " DD.MM.YYYY
      lv_dd = lv_p1. lv_mm = lv_p2. lv_yy = lv_p3.
      IF strlen( lv_p3 ) = 2.
        lv_yy = 2000 + lv_p3.
      ENDIF.
    ENDIF.
    CONCATENATE lv_yy lv_mm lv_dd INTO cv_d.
  ENDIF.

  CALL FUNCTION 'DATE_CHECK_PLAUSIBILITY'
    EXPORTING
      date                      = cv_d
    EXCEPTIONS
      plausibility_check_failed = 1
      OTHERS                    = 2.
  IF sy-subrc = 0.
    cv_ok = abap_true.
  ELSE.
    CLEAR cv_d.
  ENDIF.
ENDFORM.

*----------------------------------------------------------------------*
* Save as a new version: ZPS_T_FR_HDR + ZPS_T_FR_ITM + ZPS_T_FR_CST
*----------------------------------------------------------------------*
FORM save_version.
  DATA: ls_hdr    TYPE zps_t_fr_hdr,
        ls_first  TYPE zps_t_fr_hdr,
        lt_itm    TYPE STANDARD TABLE OF zps_t_fr_itm,
        ls_itm    TYPE zps_t_fr_itm,
        lt_cst    TYPE STANDARD TABLE OF zps_t_fr_cst,
        ls_cst    TYPE zps_t_fr_cst,
        ls_ln     TYPE ty_line,
        lv_last   TYPE zps_t_fr_hdr-versn,
        lv_varkey TYPE rstable-varkey,
        lv_txt    TYPE string.

  lv_varkey(3)    = sy-mandt.
  lv_varkey+3(24) = gs_proj-pspid.
  CALL FUNCTION 'ENQUEUE_E_TABLE'
    EXPORTING
      mode_rstable   = 'E'
      tabname        = gc_lock_tab
      varkey         = lv_varkey
    EXCEPTIONS
      foreign_lock   = 1
      system_failure = 2
      OTHERS         = 3.
  IF sy-subrc <> 0.
    CONCATENATE 'Fleet schedule of the project is locked by' sy-msgv1
      INTO lv_txt SEPARATED BY space.
    PERFORM add_log USING 0 'E' lv_txt.
    RETURN.
  ENDIF.

* someone saved in the meantime?
  SELECT MAX( versn ) FROM zps_t_fr_hdr INTO lv_last
    WHERE pspid = gs_proj-pspid.
  IF lv_last <> gv_versn.
    CONCATENATE 'Version' lv_last 'was saved meanwhile - download again' INTO lv_txt SEPARATED BY space.
    PERFORM add_log USING 0 'E' lv_txt.
    PERFORM dequeue USING lv_varkey.
    RETURN.
  ENDIF.

* header - created by = first version, changed by = this upload
  SELECT SINGLE * FROM zps_t_fr_hdr INTO ls_first
    WHERE pspid = gs_proj-pspid AND versn = '001'.
  ls_hdr-mandt   = sy-mandt.
  ls_hdr-pspid   = gs_proj-pspid.
  ls_hdr-versn   = lv_last + 1.
  ls_hdr-basever = gv_versn.
  ls_hdr-spmon   = gv_spmon.
  ls_hdr-perfr   = gv_perfr.
  ls_hdr-perto   = gv_perto.
  ls_hdr-ownhr   = gv_ownhr.
  ls_hdr-plfaz   = gs_proj-plfaz.
  ls_hdr-plsez   = gs_proj-plsez.
  ls_hdr-expcd   = gv_expcd.
  ls_hdr-sncost  = gv_sncost.
  ls_hdr-waers   = gv_waers.
  ls_hdr-fname   = p_file.
  ls_hdr-nlines  = lines( gt_line ).
  IF ls_first IS INITIAL.
    ls_hdr-ernam = sy-uname. ls_hdr-erdat = sy-datum. ls_hdr-erzet = sy-uzeit.
  ELSE.
    ls_hdr-ernam = ls_first-ernam. ls_hdr-erdat = ls_first-erdat. ls_hdr-erzet = ls_first-erzet.
  ENDIF.
  ls_hdr-aenam = sy-uname. ls_hdr-aedat = sy-datum. ls_hdr-aezet = sy-uzeit.

  LOOP AT gt_line INTO ls_ln.
    CLEAR ls_itm.
    MOVE-CORRESPONDING ls_ln TO ls_itm.
    ls_itm-mandt = sy-mandt.
    ls_itm-pspid = gs_proj-pspid.
    ls_itm-versn = ls_hdr-versn.
    ls_itm-waers = gv_waers.
    APPEND ls_itm TO lt_itm.
    ls_hdr-plntot = ls_hdr-plntot + ls_itm-plncst.
    ls_hdr-acttot = ls_hdr-acttot + ls_itm-actcst.

    CLEAR ls_cst.
    ls_cst-mandt = sy-mandt.
    ls_cst-pspid = gs_proj-pspid.
    ls_cst-versn = ls_hdr-versn.
    ls_cst-linid = ls_ln-linid.
    ls_cst-spmon = gv_spmon.
    ls_cst-waers = gv_waers.
    ls_cst-ernam = sy-uname. ls_cst-erdat = sy-datum. ls_cst-erzet = sy-uzeit.
    ls_cst-aenam = sy-uname. ls_cst-aedat = sy-datum. ls_cst-aezet = sy-uzeit.

    ls_cst-cstyp = gc_cst_plan.
    ls_cst-ihc = ls_ln-pl_ihc. ls_cst-opr = ls_ln-pl_opr. ls_cst-fuel = ls_ln-pl_fuel.
    ls_cst-total = ls_cst-ihc + ls_cst-opr + ls_cst-fuel.
    APPEND ls_cst TO lt_cst.

    ls_cst-cstyp = gc_cst_act.
    ls_cst-ihc = ls_ln-ac_ihc. ls_cst-opr = ls_ln-ac_opr. ls_cst-fuel = ls_ln-ac_fuel.
    ls_cst-total = ls_cst-ihc + ls_cst-opr + ls_cst-fuel.
    APPEND ls_cst TO lt_cst.

    ls_cst-cstyp = gc_cst_itd.
    ls_cst-ihc = ls_ln-it_ihc. ls_cst-opr = ls_ln-it_opr. ls_cst-fuel = ls_ln-it_fuel.
    ls_cst-total = ls_cst-ihc + ls_cst-opr + ls_cst-fuel.
    APPEND ls_cst TO lt_cst.
  ENDLOOP.

  INSERT zps_t_fr_hdr FROM ls_hdr.
  IF sy-subrc = 0.
    INSERT zps_t_fr_itm FROM TABLE lt_itm.
  ENDIF.
  IF sy-subrc = 0.
    INSERT zps_t_fr_cst FROM TABLE lt_cst.
  ENDIF.

  IF sy-subrc = 0.
    COMMIT WORK AND WAIT.
    CONCATENATE 'Version' ls_hdr-versn 'saved for project' gv_ext_pspid
      INTO lv_txt SEPARATED BY space.
    PERFORM add_log USING 0 'S' lv_txt.
  ELSE.
    ROLLBACK WORK.                                     "#EC CI_ROLLBACK
    PERFORM add_log USING 0 'E' 'Database update failed - nothing saved'.
  ENDIF.

  PERFORM dequeue USING lv_varkey.
ENDFORM.

FORM dequeue USING iv_varkey TYPE rstable-varkey.
  CALL FUNCTION 'DEQUEUE_E_TABLE'
    EXPORTING
      mode_rstable = 'E'
      tabname      = gc_lock_tab
      varkey       = iv_varkey.
ENDFORM.

  DATA lv_p TYPE string.
  lv_p = p_pspid.
  REPLACE ALL OCCURRENCES OF REGEX '[^A-Za-z0-9_-]' IN lv_p WITH '_'.
  CONCATENATE 'Fleet_Resource_Schedule_' lv_p '_' sy-datum '.xlsx' INTO cv.

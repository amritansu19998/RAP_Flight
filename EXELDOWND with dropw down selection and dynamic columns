FORM check_webgui.
  DATA lv_its TYPE c LENGTH 1.
  CALL FUNCTION 'GUI_IS_ITS'
    IMPORTING
      return = lv_its.
  IF lv_its IS NOT INITIAL.
    gv_webgui = abap_true.
  ENDIF.
ENDFORM.

*----------------------------------------------------------------------*
FORM set_listbox.
  DATA: lt_val TYPE vrm_values,
        ls_val TYPE vrm_value.
  ls_val-key = gc_own.   ls_val-text = 'Own'.   APPEND ls_val TO lt_val.
  ls_val-key = gc_lease. ls_val-text = 'Lease'. APPEND ls_val TO lt_val.
  ls_val-key = gc_hired. ls_val-text = 'Hired'. APPEND ls_val TO lt_val.
  CALL FUNCTION 'VRM_SET_VALUES'
    EXPORTING
      id     = 'P_OWNHR'
      values = lt_val
    EXCEPTIONS
      OTHERS = 1.
ENDFORM.

*----------------------------------------------------------------------*
FORM read_project.
  DATA: lv_ext  TYPE c LENGTH 24,
        lv_txt  TYPE string,
        lv_butx TYPE t001-butxt,
        lv_wae  TYPE t001-waers,
        lv_ltxt TYPE cepct-ltext,
        lv_ktxt TYPE cepct-ktext.

  SELECT SINGLE pspnr pspid post1 plfaz plsez vbukr vkokr prctr pwhie werks
    FROM proj INTO gs_proj
    WHERE pspid = p_pspid.
  IF sy-subrc <> 0.
    MESSAGE 'Project does not exist' TYPE 'E'.
  ENDIF.

  CALL FUNCTION 'CONVERSION_EXIT_ABPSP_OUTPUT'
    EXPORTING
      input  = gs_proj-pspid
    IMPORTING
      output = lv_ext.
  gv_ext_pspid = lv_ext.
  CONDENSE gv_ext_pspid.

  SELECT SINGLE butxt waers FROM t001 INTO (lv_butx, lv_wae)
    WHERE bukrs = gs_proj-vbukr.
  gv_company = lv_butx.
  gv_waers   = gs_proj-pwhie.
  IF gv_waers IS INITIAL.
    gv_waers = lv_wae.
  ENDIF.

* business unit line = profit center text
  CLEAR gv_bu.
  IF gs_proj-prctr IS NOT INITIAL.
    SELECT ltext ktext FROM cepct INTO (lv_ltxt, lv_ktxt) UP TO 1 ROWS
      WHERE spras = sy-langu
        AND prctr = gs_proj-prctr
        AND kokrs = gs_proj-vkokr
        AND datbi >= sy-datum
      ORDER BY datbi.
    ENDSELECT.
    IF lv_ltxt IS NOT INITIAL.
      gv_bu = lv_ltxt.
    ELSE.
      gv_bu = lv_ktxt.
    ENDIF.
  ENDIF.

  PERFORM read_client.

  IF gs_proj-plfaz IS INITIAL OR gs_proj-plsez IS INITIAL.
    lv_txt = 'Project start / finish dates are not maintained - contractual dates will be blank'.
    MESSAGE lv_txt TYPE 'S' DISPLAY LIKE 'W'.
  ENDIF.
  IF gs_proj-werks IS INITIAL.
    lv_txt = 'Project has no plant (PROJ-WERKS) - equipment dropdown will be empty'.
    MESSAGE lv_txt TYPE 'S' DISPLAY LIKE 'W'.
  ENDIF.
ENDFORM.

*----------------------------------------------------------------------*
* CONFIRM: Client = sold-to of the sales order assigned to a WBS
* element of the project (VBAP-PS_PSP_PNR). Replace if the client is
* kept elsewhere (e.g. a PROJ customer field).
*----------------------------------------------------------------------*
FORM read_client.
  DATA: lv_kunnr TYPE kunnr,
        lv_name1 TYPE kna1-name1.
  CLEAR gv_client.
  SELECT k~kunnr FROM vbak AS k
    INNER JOIN vbap AS p ON p~vbeln = k~vbeln
    INNER JOIN prps AS w ON w~pspnr = p~ps_psp_pnr
    INTO lv_kunnr UP TO 1 ROWS
    WHERE w~psphi = gs_proj-pspnr.
  ENDSELECT.
  IF lv_kunnr IS NOT INITIAL.
    SELECT SINGLE name1 FROM kna1 INTO lv_name1 WHERE kunnr = lv_kunnr.
    gv_client = lv_name1.
  ENDIF.
ENDFORM.


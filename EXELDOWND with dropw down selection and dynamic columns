*----------------------------------------------------------------------*
* Reporting windows
*   IHC / Hire / Operator : 26th of previous month .. 25th of month
*   Fuel                  : calendar month (KOC4, selected month)
*   ITD                   : project start .. end of the same window
*----------------------------------------------------------------------*
FORM set_windows.
  DATA lv_d TYPE d.
  IF gv_spmon IS INITIAL.
    gv_spmon = sy-datum(6).
  ENDIF.
  CONCATENATE gv_spmon '25' INTO gv_mon_to.
  CONCATENATE gv_spmon '01' INTO lv_d.
  lv_d = lv_d - 1.                     " last day of previous month
  CONCATENATE lv_d(6) '26' INTO gv_mon_from.
  CONCATENATE gv_spmon '01' INTO gv_cal_from.
  PERFORM last_day USING gv_spmon CHANGING gv_cal_to.
  gv_itd_from = gs_proj-plfaz.
  IF gv_itd_from IS INITIAL OR gv_itd_from > gv_mon_to.
    gv_itd_from = '19000101'.
  ENDIF.
ENDFORM.

*----------------------------------------------------------------------*
FORM col_letter USING    iv_col TYPE i
                CHANGING cv_txt TYPE string.
  DATA: lv_n TYPE i,
        lv_r TYPE i,
        lv_c TYPE c LENGTH 1.
  CLEAR cv_txt.
  lv_n = iv_col.
  WHILE lv_n > 0.
    lv_r = ( lv_n - 1 ) MOD 26.
    lv_c = sy-abcde+lv_r(1).
    CONCATENATE lv_c cv_txt INTO cv_txt.
    lv_n = ( lv_n - 1 ) DIV 26.
  ENDWHILE.
ENDFORM.

FORM cell_ref USING iv_col TYPE i iv_row TYPE i CHANGING cv TYPE string.
  DATA lv_r TYPE string.
  PERFORM col_letter USING iv_col CHANGING cv.
  lv_r = iv_row.
  CONDENSE lv_r.
  CONCATENATE cv lv_r INTO cv.
ENDFORM.

FORM addr USING    iv_c1 TYPE i iv_r1 TYPE i
                   iv_c2 TYPE i iv_r2 TYPE i
          CHANGING cv    TYPE string.
  DATA: lv_a TYPE string, lv_b TYPE string.
  PERFORM cell_ref USING iv_c1 iv_r1 CHANGING lv_a.
  PERFORM cell_ref USING iv_c2 iv_r2 CHANGING lv_b.
  CONCATENATE lv_a ':' lv_b INTO cv.
ENDFORM.

FORM add_merge USING iv_c1 TYPE i iv_r1 TYPE i iv_c2 TYPE i iv_r2 TYPE i.
  DATA lv_a TYPE string.
  PERFORM addr USING iv_c1 iv_r1 iv_c2 iv_r2 CHANGING lv_a.
  APPEND lv_a TO gt_merge.
ENDFORM.

* "AB12" -> col 28, row 12
FORM parse_ref USING iv_ref TYPE string CHANGING cv_col TYPE i cv_row TYPE i.
  DATA: lv_len TYPE i,
        lv_i   TYPE i,
        lv_off TYPE i,
        lv_c   TYPE c LENGTH 1,
        lv_num TYPE string.
  CLEAR: cv_col, cv_row.
  lv_len = strlen( iv_ref ).
  DO lv_len TIMES.
    lv_i = sy-index - 1.
    lv_c = iv_ref+lv_i(1).
    IF lv_c CA sy-abcde.
      FIND lv_c IN sy-abcde MATCH OFFSET lv_off.
      cv_col = cv_col * 26 + lv_off + 1.
    ELSE.
      lv_num = iv_ref+lv_i.
      cv_row = lv_num.
      EXIT.
    ENDIF.
  ENDDO.
ENDFORM.


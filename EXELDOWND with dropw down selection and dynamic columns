*----------------------------------------------------------------------*
FORM f4_file.
  DATA: lt_files  TYPE filetable,
        ls_file   TYPE file_table,
        lv_rc     TYPE i,
        lv_action TYPE i,
        lv_name   TYPE string,
        lv_path   TYPE string,
        lv_full   TYPE string,
        lv_defnm  TYPE string,
        lt_dynp   TYPE STANDARD TABLE OF dynpread,
        ls_dynp   TYPE dynpread.

  ls_dynp-fieldname = 'RB_UP'.
  APPEND ls_dynp TO lt_dynp.
  CALL FUNCTION 'DYNP_VALUES_READ'
    EXPORTING
      dyname     = sy-repid
      dynumb     = sy-dynnr
    TABLES
      dynpfields = lt_dynp
    EXCEPTIONS
      OTHERS     = 1.
  READ TABLE lt_dynp INTO ls_dynp INDEX 1.
  IF sy-subrc = 0.
    rb_up = ls_dynp-fieldvalue.
  ENDIF.

  IF rb_up = abap_true.
    cl_gui_frontend_services=>file_open_dialog(
      EXPORTING
        window_title = 'Select Fleet & Resource Schedule file'
        file_filter  = 'Excel (*.xlsx)|*.xlsx'
      CHANGING
        file_table   = lt_files
        rc           = lv_rc
      EXCEPTIONS
        OTHERS       = 1 ).
    READ TABLE lt_files INTO ls_file INDEX 1.
    IF sy-subrc = 0.
      p_file = ls_file-filename.
    ENDIF.
  ELSE.

FORM avl_text USING iv TYPE zps_t_fr_itm-avlrq CHANGING cv TYPE string.
  CASE iv.
    WHEN 'AVL'. cv = 'Avl'.
    WHEN 'REQ'. cv = 'Req'.
    WHEN 'SUR'. cv = 'Sur'.
    WHEN OTHERS. CLEAR cv.
  ENDCASE.
ENDFORM.

FORM avl_code USING iv TYPE string CHANGING cv TYPE zps_t_fr_itm-avlrq cv_ok TYPE abap_bool.
  DATA lv TYPE string.
  cv_ok = abap_true.
  CLEAR cv.
  lv = iv.
  TRANSLATE lv TO UPPER CASE.
  CONDENSE lv NO-GAPS.
  IF strlen( lv ) > 3.
    lv = lv(3).
  ENDIF.
  CASE lv.
    WHEN 'AVL' OR 'REQ' OR 'SUR'. cv = lv.
    WHEN ''.
    WHEN OTHERS. cv_ok = abap_false.
  ENDCASE.
ENDFORM.

